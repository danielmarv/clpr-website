---
/**
 * The engine's page frame wearing the CLPR website's chrome: its header and footer in the full-width
 * slots, its fonts preloaded, the stored colour theme applied before first paint, and
 * src/styles/site-theme.css redefining the engine's tokens.
 */
import Base from '@kse/layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import sora from '../assets/fonts/sora-latin-wght-normal.woff2?url';
import { PACK } from '../lib/sources';
import '../styles/site-theme.css';

interface Props {
  title: string;
  description: string;
  sections: { id: string; title: string; num?: string }[];
  acts?: { id: string; numeral: string; name: string; first: string }[];
  path: '/' | '/developers/';
}
const props = Astro.props;
const themeColor = (PACK as { themeColor: { light: string; dark: string } }).themeColor;
---
<Base {...props}>
  <link slot="head" rel="preload" href={sora} as="font" type="font/woff2" crossorigin />
  {/* The website's theme rule, before first paint: a stored light, dark or system goes on
      <html data-theme>; anything else is light, whatever the system says. The engine's own head
      script, which runs next, only knows light and dark. */}
  <script is:inline slot="head" define:vars={{ themeColor }}>
    let theme = null;
    try { theme = localStorage.getItem('theme'); } catch (e) {}
    if (theme === 'light' || theme === 'dark' || theme === 'system') document.documentElement.setAttribute('data-theme', theme);
    else document.documentElement.removeAttribute('data-theme');
    try { if (localStorage.getItem('toc-collapsed') === '1') document.documentElement.classList.add('toc-collapsed'); } catch (e) {}
    const dark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
    document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => meta.setAttribute('content', dark ? themeColor.dark : themeColor.light));
  </script>
  <SiteHeader slot="header" path={props.path} />
  <slot />
  <SiteFooter slot="footer" />
</Base>
{/* The Contents column can be hidden on wide screens; the choice is kept across both pages. The
    hidden state is applied before first paint by the head script above. */}
<script>
  const column = document.querySelector<HTMLElement>('.page > .toc-col');
  if (column) {
    const root = document.documentElement;
    column.id = 'toc';
    const icon = (arrow: string) =>
      `<svg viewBox="0 0 24 24" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" /><path d="M9 3v18" /><path d="${arrow}" /></svg>`;
    const make = (className: string, label: string, arrow: string) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = `toc-toggle ${className}`;
      button.setAttribute('aria-controls', 'toc');
      button.title = label;
      button.innerHTML = `${icon(arrow)}<span class="${className === 'toc-hide' ? 'visually-hidden' : 'toc-label'}">${label}</span>`;
      return button;
    };
    const hide = make('toc-hide', 'Hide contents', 'm16 15-3-3 3-3');
    const show = make('toc-show', 'Contents', 'm14 9 3 3-3 3');
    column.prepend(hide);
    document.body.append(show);
    const apply = (collapsed: boolean, moveFocus: boolean) => {
      root.classList.toggle('toc-collapsed', collapsed);
      hide.setAttribute('aria-expanded', String(!collapsed));
      show.setAttribute('aria-expanded', String(!collapsed));
      try { localStorage.setItem('toc-collapsed', collapsed ? '1' : '0'); } catch (e) {}
      if (moveFocus) (collapsed ? show : hide).focus();
    };
    apply(root.classList.contains('toc-collapsed'), false);
    hide.addEventListener('click', () => apply(true, true));
    show.addEventListener('click', () => apply(false, true));
  }
</script>
