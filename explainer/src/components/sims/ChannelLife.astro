---
/**
 * Channel lifecycle state machine, per spec §2.1.1 and design §3.1.3.
 * detail=true adds the exact trigger conditions to each transition: short mono labels beside the
 * edges and the full condition on the log's first line. The flag is rendered at build time as
 * data-detail on the root (Astro's module scripts have no document.currentScript).
 */
const { id = 'channel-life', detail = false } = Astro.props as { id?: string; detail?: boolean };
// kind: ok = normal operation, bad = paused, trans = in progress (dashed), end = terminal / nothing
const S = [
  { k: 'NONE', x: 60, y: 70, w: 100, label: '(no channel)', sub: 'nothing', kind: 'end' },
  { k: 'PENDING', x: 280, y: 70, w: 100, label: 'PENDING', sub: 'claimed, silent', kind: 'trans' },
  { k: 'ACTIVE', x: 500, y: 70, w: 112, label: 'ACTIVE', sub: 'normal operation', kind: 'ok' },
  { k: 'CLOSING', x: 720, y: 70, w: 100, label: 'CLOSING', sub: 'no new sends', kind: 'trans' },
  { k: 'PAUSED', x: 480, y: 180, w: 130, label: 'PAUSED', sub: 'out-of-order replies', kind: 'bad' },
  { k: 'DRAINED', x: 720, y: 180, w: 110, label: 'DRAINED', sub: 'all our data acked', kind: 'trans' },
  { k: 'CLOSED', x: 720, y: 290, w: 100, label: 'CLOSED', sub: 'terminal', kind: 'end' },
];
const arr = `${id}-arr`;
const arrOk = `${id}-arr-ok`;
---
<div class="sim chlife" id={id} data-detail={detail ? 'true' : 'false'}>
  <div class="sim__head"><div><span class="kind">Simulation</span><h3>The life of a channel</h3></div><span class="pill grey" data-role="state">no channel yet</span></div>
  <div class="sim__body">
    <div class="sim__scroll">
      <svg viewBox="0 0 780 340" role="img" aria-label="State diagram: none, pending, active, paused, closing, drained, closed.">
        <defs>
          <marker id={arr} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--text-3)" /></marker>
          <marker id={arrOk} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--ok)" /></marker>
        </defs>
        <g class="edges" fill="none" stroke-width="1.5" marker-end={`url(#${arr})`}>
          <path d="M110,70 H230" pathLength="1" data-edge="NONE-PENDING" />
          <path d="M330,70 H444" pathLength="1" data-edge="PENDING-ACTIVE" />
          <path d="M556,70 H670" pathLength="1" data-edge="ACTIVE-CLOSING" />
          <path d="M250,45 C250,4 90,4 90,45" pathLength="1" data-edge="PENDING-NONE" />
          <path d="M480,95 V155" pathLength="1" data-edge="ACTIVE-PAUSED" />
          <path d="M520,155 V95" pathLength="1" data-edge="PAUSED-ACTIVE" />
          <path d="M545,160 L690,95" pathLength="1" data-edge="PAUSED-CLOSING" />
          <path d="M720,95 V155" pathLength="1" data-edge="CLOSING-DRAINED" />
          <path d="M720,205 V265" pathLength="1" data-edge="DRAINED-CLOSED" />
        </g>
        <text x="170" y="40" class="t small center muted">deleted</text>
        {detail && (
          <g class="triggers">
            <text x="170" y="27" class="t mono center muted">closeChannel</text>
            <text x="170" y="60" class="t mono center muted">registerChannel</text>
            <text x="390" y="60" class="t mono center muted">completeChannel</text>
            <text x="610" y="48" class="t mono center muted">closeChannel</text>
            <text x="610" y="60" class="t mono center muted">or peer CLOSING</text>
            <text x="472" y="116" class="t mono muted" text-anchor="end">reply mismatch</text>
            <text x="528" y="116" class="t mono muted">ordered bundle</text>
            <text x="605" y="176" class="t mono center muted">closeChannel</text>
            <text x="605" y="188" class="t mono center muted">or peer CLOSING</text>
            <text x="712" y="140" class="t mono muted" text-anchor="end">queue acked</text>
            <text x="712" y="228" class="t mono muted" text-anchor="end">peer DRAINED/CLOSED</text>
            <text x="712" y="240" class="t mono muted" text-anchor="end">+ queue acked</text>
            <text x="712" y="252" class="t mono muted" text-anchor="end">or closeChannel</text>
          </g>
        )}
        {S.map((s) => (
          <g data-state={s.k} data-kind={s.kind}>
            <rect x={s.x - s.w / 2} y={s.y - 25} width={s.w} height="50" rx="10" class={s.kind === 'end' ? 'd-grey' : 'd-surface'} />
            <text x={s.x} y={s.y - 3} class="t center b">{s.label}</text>
            <text x={s.x} y={s.y + 14} class="t small center muted">{s.sub}</text>
          </g>
        ))}
      </svg>
    </div>
    <p class="sim__scroll-note">Wider than a phone; scroll it sideways if you need to.</p>
  </div>
  <div class="sim__controls">
    <div class="group">
      <span class="kicker">you / admin</span>
      <button class="btn" type="button" data-ev="register">registerChannel (commit)</button>
      <button class="btn" type="button" data-ev="complete">completeChannel (reveal)</button>
      <button class="btn" type="button" data-ev="close">admin: closeChannel</button>
    </div>
    <div class="group">
      <span class="kicker">arrives in a bundle</span>
      <button class="btn" type="button" data-ev="ooo">bundle: replies out of order</button>
      <button class="btn" type="button" data-ev="good">bundle: replies in order</button>
      <button class="btn" type="button" data-ev="peerclosing">bundle: peer says CLOSING</button>
      <button class="btn" type="button" data-ev="acked">bundle: peer acked all our data</button>
      <button class="btn" type="button" data-ev="peerdrained">bundle: peer DRAINED and our queue empty</button>
    </div>
    <span class="spacer"></span>
    <button class="btn" type="button" data-ev="reset">Reset</button>
  </div>
  <div class="sim__log" data-role="log"><span class="line" data-role="line">state: NONE</span><span data-role="prose">Only some events make sense in each state; the others are greyed out. Start by registering a channel.</span></div>
</div>
<style>
  .chlife .edges path { stroke: var(--border-2); }
  .chlife .edges path.avail { stroke: var(--text-3); }
  .chlife .edges path.hint { stroke: var(--a); stroke-width: 2.5; }
  .chlife .edges path.lit { stroke: var(--ok); stroke-width: 2.5; stroke-dasharray: 1; animation: chlife-draw 400ms ease-out; }
  @keyframes chlife-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  .sim.chlife svg g.on rect { stroke-width: 2.5; animation: chlife-pop 500ms ease; }
  .chlife g.on[data-kind="ok"] rect { fill: var(--ok-soft); stroke: var(--ok); }
  .chlife g.on[data-kind="bad"] rect { fill: var(--bad-soft); stroke: var(--bad); }
  .chlife g.on[data-kind="trans"] rect { fill: var(--surface); stroke: var(--ok); stroke-dasharray: 6 4; }
  .chlife g.on[data-kind="end"] rect { fill: var(--grey-soft); stroke: var(--text-3); }
  @keyframes chlife-pop { 50% { stroke-width: 4; } }
  .chlife .sim__controls .group { margin-right: 6px; }
</style>

<script>
  type St = 'NONE' | 'PENDING' | 'ACTIVE' | 'PAUSED' | 'CLOSING' | 'DRAINED' | 'CLOSED';
  for (const root of Array.from(document.querySelectorAll<HTMLElement>('.sim.chlife'))) {
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
    const detailMode = root.dataset.detail === 'true';
    const log = $('[data-role="prose"]');
    const line = $('[data-role="line"]');
    const pill = $('[data-role="state"]');
    const arrOk = `url(#${root.id}-arr-ok)`;
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('button[data-ev]'));
    const edges = Array.from(root.querySelectorAll<SVGPathElement>('path[data-edge]'));
    let st: St = 'NONE';
    const allowed: Record<St, string[]> = {
      NONE: ['register'], PENDING: ['complete', 'close'], ACTIVE: ['close', 'ooo', 'peerclosing'], PAUSED: ['close', 'good', 'peerclosing'],
      CLOSING: ['acked'], DRAINED: ['peerdrained', 'close'], CLOSED: [],
    };
    const words: Record<St, string> = {
      NONE: 'no channel yet', PENDING: 'PENDING: the id is claimed but nothing can be sent', ACTIVE: 'ACTIVE: messages flow both ways',
      PAUSED: 'PAUSED: replies arrived out of order; no new sends until the peer fixes it', CLOSING: 'CLOSING: no new sends; everything in flight completes',
      DRAINED: 'DRAINED: every data message we sent was acknowledged; waiting on the peer', CLOSED: 'CLOSED: terminal; after one final close-notification, endpoints stop syncing',
    };
    // Where each event leads from a given state (the edge it lights and the exact trigger, for detail mode).
    const target: Record<string, Partial<Record<St, St>>> = {
      register: { NONE: 'PENDING' }, complete: { PENDING: 'ACTIVE' },
      close: { PENDING: 'NONE', ACTIVE: 'CLOSING', PAUSED: 'CLOSING', DRAINED: 'CLOSED' },
      ooo: { ACTIVE: 'PAUSED' }, good: { PAUSED: 'ACTIVE' }, peerclosing: { ACTIVE: 'CLOSING', PAUSED: 'CLOSING' },
      acked: { CLOSING: 'DRAINED' }, peerdrained: { DRAINED: 'CLOSED' },
    };
    const trigger: Record<string, string> = {
      register: 'registerChannel(commitment); commitment = keccak256(channel_id ‖ public_key)',
      complete: 'completeChannel: preimage revealed, signature over keccak256(channel_id), verifyConfig ok',
      'close@PENDING': 'closeChannel on a PENDING claim: the claim is deleted',
      'close@ACTIVE': 'closeChannel (admin only): sendMessage rejected, in flight completes',
      'close@PAUSED': 'closeChannel (admin only): sendMessage rejected, in flight completes',
      'close@DRAINED': 'closeChannel on DRAINED (recovery): outbound queue already fully acked',
      ooo: 'response id != oldest unresponded Data Message id',
      good: 'next inbound bundle has correctly ordered responses',
      peerclosing: 'peer ChannelSyncData.status in {CLOSING, DRAINED, CLOSED}',
      acked: 'no Data Message with id > acked_message_id left in the outbound queue',
      peerdrained: 'peer status DRAINED or CLOSED and acked_message_id >= next_message_id - 1',
    };
    const edgeFor = (ev: string, from: St) => { const to = target[ev]?.[from]; return to ? `${from}-${to}` : ''; };
    function paintEdges(lit: string) {
      for (const e of edges) {
        const key = e.dataset.edge!;
        const [from] = key.split('-');
        const avail = from === st && allowed[st].some((ev) => edgeFor(ev, st) === key);
        e.classList.toggle('avail', avail && key !== lit);
        if (key === lit) {
          e.classList.remove('lit'); void e.getBoundingClientRect(); // restart the draw-on animation
          e.classList.add('lit'); e.setAttribute('marker-end', arrOk);
        } else { e.classList.remove('lit'); e.removeAttribute('marker-end'); }
      }
    }
    function set(next: St, ev: string, why: string, init = false) {
      const prev = st; st = next;
      for (const g of Array.from(root.querySelectorAll<SVGGElement>('g[data-state]'))) g.classList.toggle('on', g.dataset.state === st);
      paintEdges(ev ? `${prev}-${next}` : '');
      for (const b of buttons) b.disabled = b.dataset.ev !== 'reset' && !allowed[st].includes(b.dataset.ev!);
      const changed = pill.textContent !== (st === 'NONE' ? 'no channel yet' : st);
      pill.textContent = st === 'NONE' ? 'no channel yet' : st;
      pill.className = 'pill ' + (st === 'ACTIVE' ? 'ok' : st === 'PAUSED' ? 'bad' : 'grey');
      if (changed) pill.classList.add('pulse');
      if (ev) {
        const label = buttons.find((b) => b.dataset.ev === ev)?.textContent ?? ev;
        line.textContent = detailMode ? `${prev} -> ${next} · ${trigger[`${ev}@${prev}`] ?? trigger[ev]}` : `${prev} -> ${next} · ${label}`;
      } else line.textContent = `state: ${st}`;
      if (!init) log.innerHTML = why ? `${why} <br/><strong>${words[st]}</strong>` : words[st];
    }
    pill.addEventListener('animationend', () => pill.classList.remove('pulse'));
    const handlers: Record<string, () => void> = {
      register: () => set('PENDING', 'register', 'Anyone may register a 32-byte ownership commitment, keccak256(channel_id ‖ public_key). Neither value is revealed yet, so nobody can race to claim the same id on the other ledger.'),
      complete: () => set('ACTIVE', 'complete', 'The registrant reveals the channel id and public key, proves control of the key with a signature, names the verifier contract (fixed for life), and supplies proofs of the peer\'s configuration and endpoint list. The service verifies all of it.'),
      close: () => {
        if (st === 'PENDING') set('NONE', 'close', 'An abandoned claim is simply deleted; no messages were ever exchanged.');
        else if (st === 'ACTIVE' || st === 'PAUSED') set('CLOSING', 'close', 'Only the CLPR Service admin can close. From ACTIVE or PAUSED the channel starts a graceful drain: no new sends, but everything in flight still completes. The peer learns of it through the status carried in the next sync.');
        else if (st === 'DRAINED') set('CLOSED', 'close', 'Recovery path: if the peer\'s endpoint can never deliver its final close-notification, the admin closes a DRAINED channel directly. Nothing is abandoned because the outbound queue is already fully acknowledged.');
      },
      ooo: () => set('PAUSED', 'ooo', 'A reply arrived that does not match the oldest unanswered data message. That means the peer\'s reply generation is broken, so the channel pauses rather than delivering out of order. The bad bundle is rejected; nothing was dispatched.'),
      good: () => set('ACTIVE', 'good', 'A bundle with correctly ordered replies arrived. The channel resumes on its own; no admin action is needed.'),
      peerclosing: () => set('CLOSING', 'peerclosing', 'The peer\'s sync data says CLOSING (or DRAINED, or CLOSED). Our side follows into CLOSING so both drain together.'),
      acked: () => set('DRAINED', 'acked', 'No data message with an id above acked_message_id remains in our outbound queue: the peer has everything we sent. Replies we generated while closing may still be in flight; they drain through this state.'),
      peerdrained: () => set('CLOSED', 'peerdrained', 'The peer reports DRAINED or CLOSED and our own queue is fully acknowledged (acked_message_id ≥ next_message_id − 1). Both sides are done. The endpoint\'s last duty is one close-notification bundle to the peer.'),
      reset: () => set('NONE', '', ''),
    };
    for (const b of buttons) {
      b.addEventListener('click', () => handlers[b.dataset.ev!]());
      // Tie each button to its line on the picture while it is hovered or focused.
      const hint = (on: boolean) => { const key = edgeFor(b.dataset.ev!, st); for (const e of edges) e.classList.toggle('hint', on && e.dataset.edge === key); };
      b.addEventListener('mouseenter', () => hint(true)); b.addEventListener('mouseleave', () => hint(false));
      b.addEventListener('focus', () => hint(true)); b.addEventListener('blur', () => hint(false));
    }
    set('NONE', '', '', true);
  }
</script>
