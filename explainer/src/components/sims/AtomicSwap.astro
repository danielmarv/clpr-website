---
/**
 * The N-ledger atomic swap pattern (design §3.4.3): several ledgers make state changes tied
 * together by two-phase commit; all enter a ready-or-roll-back state, and if any one fails, all
 * roll back. The three sentences upstream are the whole specification of the pattern; the
 * mechanics drawn here (an application on A coordinating, prepare and commit as ordinary messages,
 * each with its reply) are the site's illustration of how such an application would use CLPR.
 * General page section 11.
 */
import Refs from '@kse/components/Refs.astro';
const { id = 'swap-sim' } = Astro.props as { id?: string };
const refs = [{ doc: 'design', anchor: '343-n-ledger-atomic-swap-2pc', label: 'design §3.4.3' }] as const;
---
<div class="sim swap" id={id}>
  <div class="sim__head"><div><span class="kind">Simulation · an illustration</span><h3>A three-ledger atomic swap, illustrated</h3></div><span class="pill grey" data-role="status">idle</span></div>
  <div class="sim__body">
    <div class="sim__scroll">
      <svg viewBox="0 0 760 262" role="img" aria-label="Three ledgers side by side. An application on Ledger A sends prepare messages to B and C over two channels, collects their replies, then sends commit or roll back.">
        <rect x="20" y="30" width="180" height="170" rx="12" class="d-a" />
        <text x="110" y="56" class="t b center">Ledger A</text>
        <rect x="35" y="70" width="150" height="58" rx="8" class="d-surface" />
        <text x="110" y="97" class="t center">the swap application</text>
        <text x="110" y="112" class="t small center">starts it, keeps the tally</text>
        <rect x="35" y="142" width="150" height="40" rx="8" class="d-surface" data-role="lockA" />
        <text x="110" y="160" class="t center">its own change</text>
        <text x="110" y="175" class="t small center" data-role="stateA">waiting</text>
        <rect x="290" y="30" width="180" height="170" rx="12" class="d-b" />
        <text x="380" y="56" class="t b center">Ledger B</text>
        <rect x="305" y="70" width="150" height="58" rx="8" class="d-surface" />
        <text x="380" y="89" class="t center">its application</text>
        <text x="380" y="104" class="t small center">answers prepare</text>
        <text x="380" y="118" class="t small center">and commit</text>
        <rect x="305" y="142" width="150" height="40" rx="8" class="d-surface" data-role="lockB" />
        <text x="380" y="160" class="t center">its change</text>
        <text x="380" y="175" class="t small center" data-role="stateB">waiting</text>
        <rect x="560" y="30" width="180" height="170" rx="12" class="d-c" />
        <text x="650" y="56" class="t b center">Ledger C</text>
        <rect x="575" y="70" width="150" height="58" rx="8" class="d-surface" />
        <text x="650" y="89" class="t center">its application</text>
        <text x="650" y="104" class="t small center">answers prepare</text>
        <text x="650" y="118" class="t small center">and commit</text>
        <rect x="575" y="142" width="150" height="40" rx="8" class="d-surface" data-role="lockC" />
        <text x="650" y="160" class="t center">its change</text>
        <text x="650" y="175" class="t small center" data-role="stateC">waiting</text>
        <line x1="200" y1="99" x2="305" y2="99" class="line c" />
        <text x="245" y="91" class="t small center">channel A–B</text>
        <path d="M200,99 C 230,284 530,284 560,99" class="line c" fill="none" />
        <text x="380" y="256" class="t small center">channel A–C</text>
        <g data-role="env" hidden>
          <rect x="-50" y="-11" width="100" height="22" rx="4" fill="var(--surface)" stroke="var(--text)" stroke-width="1.5" />
          <text x="0" y="4" class="t mono center" data-role="envlabel">prepare</text>
        </g>
      </svg>
    </div>
    <p class="sim__scroll-note">Wider than a phone; scroll it sideways if you need to.</p>
    <Refs refs={[...refs]} />
  </div>
  <div class="sim__controls">
    <button class="btn primary" type="button" data-run="ok">Run: everyone is ready</button>
    <button class="btn danger" type="button" data-run="fail">Run: C cannot</button>
    <span class="spacer"></span>
    <button class="btn" type="button" data-role="reset">Reset</button>
  </div>
  <div class="sim__log" data-role="log">Two-phase commit, carried as ordinary CLPR messages: first "get ready", then "commit" or "roll back". Every data message gets exactly one reply, which is what the tally relies on.</div>
</div>
<style is:global>
  .sim.swap [data-role^="lock"] { transition: fill 250ms, stroke 250ms; }
  .sim.swap [data-role^="lock"].ready { fill: var(--b-soft); stroke: var(--b); }
  .sim.swap [data-role^="lock"].done { fill: var(--ok-soft); stroke: var(--ok); }
  .sim.swap [data-role^="lock"].undone { fill: var(--bad-soft); stroke: var(--bad); }
  .sim.swap [data-role="env"] { transition: transform 600ms ease-in-out; }
  @media (min-width: 720px) { .sim.swap .sim__log { min-height: 6.4em; } }
</style>
<script>
  const AT: Record<string, [number, number]> = { A: [110, 120], B: [380, 120], C: [650, 120] };
  for (const root of Array.from(document.querySelectorAll<HTMLElement>('.sim.swap'))) {
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
    const log = $('[data-role="log"]');
    const status = $('[data-role="status"]');
    const env = $('[data-role="env"]');
    const envLabel = $('[data-role="envlabel"]');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, reduced ? 0 : ms));
    let runId = 0;
    const IDLE = 'Two-phase commit, carried as ordinary CLPR messages: first "get ready", then "commit" or "roll back". Every data message gets exactly one reply, which is what the tally relies on.';
    function setState(k: string, cls: string, text: string) {
      const lock = $(`[data-role="lock${k}"]`); lock.classList.remove('ready', 'done', 'undone'); if (cls) lock.classList.add(cls);
      $(`[data-role="state${k}"]`).textContent = text;
    }
    async function carry(id: number, from: string, to: string, label: string) {
      envLabel.textContent = label;
      env.removeAttribute('hidden');
      env.style.transition = 'none';
      env.style.transform = `translate(${AT[from][0]}px, ${AT[from][1] - 100}px)`;
      await wait(30); if (id !== runId) return false;
      env.style.transition = '';
      env.style.transform = `translate(${AT[to][0]}px, ${AT[to][1] - 100}px)`;
      await wait(700); if (id !== runId) return false;
      return true;
    }
    function reset() {
      runId++;
      for (const k of ['A', 'B', 'C']) setState(k, '', 'waiting');
      env.setAttribute('hidden', '');
      status.textContent = 'idle'; status.className = 'pill grey';
      log.textContent = IDLE;
    }
    async function run(fail: boolean) {
      reset();
      const id = ++runId;
      status.textContent = 'phase 1: get ready'; status.className = 'pill b';
      log.innerHTML = '<span class="line">phase 1 · prepare</span>The application on A makes its own change ready, then sends "get ready" to B and to C, one message on each channel.';
      setState('A', 'ready', 'ready, not final');
      if (!(await carry(id, 'A', 'B', 'prepare'))) return;
      setState('B', 'ready', 'ready, not final');
      if (!(await carry(id, 'B', 'A', 'reply: ready'))) return;
      log.innerHTML = '<span class="line">phase 1 · B replied</span>B made its change ready and its reply says so. One message, one reply: the tally on A now has B.';
      if (!(await carry(id, 'A', 'C', 'prepare'))) return;
      if (fail) {
        setState('C', 'undone', 'cannot');
        if (!(await carry(id, 'C', 'A', 'reply: cannot'))) return;
        status.textContent = 'phase 2: roll back'; status.className = 'pill bad';
        log.innerHTML = '<span class="line">phase 2 · one said no</span>C\'s reply says it cannot. The tally is incomplete, so A sends "roll back" to everyone who was ready.';
        if (!(await carry(id, 'A', 'B', 'roll back'))) return;
        setState('B', 'undone', 'undone');
        setState('A', 'undone', 'undone');
        if (!(await carry(id, 'B', 'A', 'reply: undone'))) return;
        env.setAttribute('hidden', '');
        status.textContent = 'rolled back'; status.className = 'pill bad';
        log.innerHTML = '<span class="line">done · nothing landed</span><span class="bad">Rolled back everywhere.</span> Here every roll-back message was relayed and honoured, so no ledger kept a change the others did not. CLPR carried three messages and three replies; the decision was the application\'s.';
      } else {
        setState('C', 'ready', 'ready, not final');
        if (!(await carry(id, 'C', 'A', 'reply: ready'))) return;
        status.textContent = 'phase 2: commit'; status.className = 'pill ok';
        log.innerHTML = '<span class="line">phase 2 · everyone ready</span>Both replies say ready. A sends "commit" on each channel and makes its own change final.';
        setState('A', 'done', 'final');
        if (!(await carry(id, 'A', 'B', 'commit'))) return;
        setState('B', 'done', 'final');
        if (!(await carry(id, 'B', 'A', 'reply: done'))) return;
        if (!(await carry(id, 'A', 'C', 'commit'))) return;
        setState('C', 'done', 'final');
        if (!(await carry(id, 'C', 'A', 'reply: done'))) return;
        env.setAttribute('hidden', '');
        status.textContent = 'committed'; status.className = 'pill ok';
        log.innerHTML = '<span class="line">done · all three landed</span><span class="ok">Committed everywhere.</span> Three ledgers changed together. Each message was verified by the channel\'s verifier against its source ledger\'s proof; the tally that tied them together lived in the application.';
      }
    }
    for (const b of Array.from(root.querySelectorAll<HTMLButtonElement>('button[data-run]'))) b.addEventListener('click', () => { void run(b.dataset.run === 'fail'); });
    $('[data-role="reset"]').addEventListener('click', reset);
  }
</script>
