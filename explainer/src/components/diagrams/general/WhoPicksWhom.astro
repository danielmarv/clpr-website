---
/** Who picks whom: an application names one connector per send; the connector decides at its own gate (allow-list, rate limit, fee) before anything is queued; several connectors can serve one channel and one connector can serve several channels. From design §3.3.1 and spec §3.3. */
import Figure from '@kse/components/Figure.astro';
import { design, spec } from '../../../lib/sources';
---
<Figure
  lead="Who picks whom."
  caption="An application names a connector on every send. The connector can refuse, limit or charge; only what it approves is queued. Several connectors can serve one channel, and one connector can serve many."
  source={[{ label: 'design §3.3.1', href: design('331-connectors') }, { label: 'spec §3.3', href: spec('33-connector-authorization-interface') }]}
  kind="spec"
  minWidth={760}
>
  <svg viewBox="0 0 760 332" role="img" aria-label="Three applications on the left each send a message naming a connector: applications 1 and 2 name connector X, application 3 names connector Y. Connector X, in the middle, has a gate of allow-list, rate limit and fee and answers yes or no per message; connector Y accepts everything. Approved messages flow to the outbound queues on the right: connector X feeds channel 2 and channel 1, connector Y also feeds channel 1. A dashed red branch from connector X shows a refused message: not queued, nothing paid.">
    <defs>
      <marker id="wpw-arrow-a" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--a)"/></marker>
      <marker id="wpw-arrow-money" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--money)"/></marker>
    </defs>

    <text x="240" y="30" class="t small center muted">send, naming the connector</text>

    <!-- Applications -->
    <rect x="20" y="40" width="170" height="46" rx="8" class="d-a" />
    <text x="105" y="59" class="t b center">Application 1</text>
    <text x="105" y="76" class="t small center">names connector X</text>

    <rect x="20" y="104" width="170" height="46" rx="8" class="d-a" />
    <text x="105" y="123" class="t b center">Application 2</text>
    <text x="105" y="140" class="t small center">names connector X</text>

    <rect x="20" y="168" width="170" height="46" rx="8" class="d-a" />
    <text x="105" y="187" class="t b center">Application 3</text>
    <text x="105" y="204" class="t small center">names connector Y</text>

    <!-- Connectors -->
    <rect x="290" y="40" width="190" height="92" rx="8" class="d-money" />
    <text x="385" y="62" class="t b center">Connector X</text>
    <text x="385" y="82" class="t small center">gate: allow-list, rate limit,</text>
    <text x="385" y="98" class="t small center">fee to the application</text>
    <text x="385" y="118" class="t small center money">yes or no, per message</text>

    <rect x="290" y="222" width="190" height="60" rx="8" class="d-money" />
    <text x="385" y="246" class="t b center">Connector Y</text>
    <text x="385" y="266" class="t small center">gate: accepts everything</text>

    <!-- Outbound queues -->
    <rect x="580" y="50" width="160" height="52" rx="8" class="d-grey" />
    <text x="660" y="72" class="t b center">Channel 2</text>
    <text x="660" y="90" class="t small center">its own outbound queue</text>

    <rect x="580" y="192" width="160" height="52" rx="8" class="d-grey" />
    <text x="660" y="214" class="t b center">Channel 1</text>
    <text x="660" y="232" class="t small center">its own outbound queue</text>

    <!-- Applications -> connectors -->
    <line x1="190" y1="63" x2="288" y2="70" class="line a" marker-end="url(#wpw-arrow-a)" />
    <line x1="190" y1="127" x2="288" y2="100" class="line a" marker-end="url(#wpw-arrow-a)" />
    <line x1="190" y1="191" x2="288" y2="248" class="line a" marker-end="url(#wpw-arrow-a)" />

    <!-- Connectors -> outbound queues -->
    <line x1="480" y1="70" x2="578" y2="76" class="line money" marker-end="url(#wpw-arrow-money)" />
    <text x="529" y="92" class="t small center money">one connector,</text>
    <text x="529" y="106" class="t small center money">two channels</text>
    <line x1="480" y1="112" x2="578" y2="206" class="line money" marker-end="url(#wpw-arrow-money)" />
    <text x="545" y="150" class="t small money">yes: queued</text>
    <line x1="480" y1="250" x2="578" y2="226" class="line money" marker-end="url(#wpw-arrow-money)" />
    <text x="529" y="270" class="t small center money">two connectors,</text>
    <text x="529" y="284" class="t small center money">one channel</text>

    <!-- Refused: not queued -->
    <line x1="340" y1="132" x2="340" y2="186" class="line bad dash" />
    <line x1="334" y1="188" x2="346" y2="200" class="line bad" />
    <line x1="334" y1="200" x2="346" y2="188" class="line bad" />
    <text x="340" y="214" class="t small center bad">no: not queued, nothing paid</text>

    <!-- takeaway -->
    <text x="380" y="322" class="t take center">The application picks the connector; the connector decides; only approved messages reach the outbound queue.</text>
  </svg>
</Figure>
