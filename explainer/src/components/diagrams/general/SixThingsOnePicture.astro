---
/** The six closing takeaways placed on the actors they belong to: proofs from a ledger's own validators (1, 3) replace a trusted party in the middle (2); endpoints carry but cannot forge (4); numbered, chained messages let one proof cover a batch (5); connectors pay and endpoints are reimbursed, and every accepted message gets exactly one reply (6). Each statement is sourced in its own earlier section; this figure only places them. */
import Figure from '@kse/components/Figure.astro';
---
<Figure
  lead="The six things on one picture."
  caption="Numbers match the list above: proofs from a ledger's own validators (1, 3) replace a trusted middleman (2); endpoints carry but cannot forge (4); numbered, chained messages let one proof cover a batch (5); connectors pay and endpoints are reimbursed (6)."
  kind="plain"
  minWidth={760}
>
  <svg viewBox="0 0 760 392" role="img" aria-label="Ledger A on the left, Ledger B on the right, an endpoint between them carrying a sealed proof, a connector below the endpoint paying it, and a crossed-out dashed box above labelled trusted party in the middle, not present. Numbered circles 1 to 6 mark where each closing statement lives. A dashed reply arrow runs from Ledger B back to Ledger A.">
    <defs>
      <marker id="stp-arrow-a" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--a)"/></marker>
      <marker id="stp-arrow-b" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--b)"/></marker>
      <marker id="stp-arrow-c" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--c)"/></marker>
      <marker id="stp-arrow-ok" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--ok)"/></marker>
      <marker id="stp-arrow-money" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--money)"/></marker>
    </defs>

    <!-- the trusted party that is not there (2) -->
    <rect x="290" y="14" width="180" height="46" rx="8" class="line bad dash"/>
    <line x1="296" y1="18" x2="464" y2="56" class="line bad"/>
    <line x1="296" y1="56" x2="464" y2="18" class="line bad"/>
    <circle cx="282" cy="37" r="9" class="d-grey"/>
    <text x="282" y="41" class="t small center b">2</text>
    <text x="380" y="34" class="t small center bad">a trusted party in the middle</text>
    <text x="380" y="50" class="t small center bad">not present</text>

    <!-- Ledger A (1, 5) -->
    <rect x="12" y="80" width="190" height="196" rx="12" class="d-a"/>
    <text x="107" y="106" class="t b center">Ledger A</text>
    <circle cx="33" cy="134" r="9" class="d-grey"/>
    <text x="33" y="138" class="t small center b">1</text>
    <text x="48" y="138" class="t small">a shared record many</text>
    <text x="48" y="154" class="t small">machines keep in sync;</text>
    <text x="48" y="170" class="t small">its validators sign proofs</text>
    <circle cx="33" cy="206" r="9" class="d-grey"/>
    <text x="33" y="210" class="t small center b">5</text>
    <text x="48" y="210" class="t small">outbound queue:</text>
    <text x="48" y="226" class="t small">numbered lines,</text>
    <text x="48" y="242" class="t small">chained by a running</text>
    <text x="48" y="258" class="t small">running hash</text>

    <!-- Endpoint (4) -->
    <rect x="292" y="120" width="176" height="96" rx="10" class="d-c"/>
    <text x="380" y="144" class="t b center">Endpoint</text>
    <circle cx="313" cy="162" r="9" class="d-grey"/>
    <text x="313" y="166" class="t small center b">4</text>
    <text x="328" y="166" class="t small">carries the proof,</text>
    <text x="328" y="182" class="t small">holds no trusted key:</text>
    <text x="328" y="198" class="t small">can delay, cannot forge</text>

    <!-- Ledger B (3) -->
    <rect x="558" y="80" width="190" height="196" rx="12" class="d-b"/>
    <text x="653" y="106" class="t b center">Ledger B</text>
    <circle cx="579" cy="134" r="9" class="d-grey"/>
    <text x="579" y="138" class="t small center b">3</text>
    <text x="594" y="138" class="t small">its verifier, fixed to</text>
    <text x="594" y="154" class="t small">the channel, checks A's</text>
    <text x="594" y="170" class="t small">validators' own signature</text>
    <text x="594" y="206" class="t small muted">then its CLPR Service</text>
    <text x="594" y="222" class="t small muted">runs the program and</text>
    <text x="594" y="238" class="t small muted">queues the reply</text>

    <!-- sealed proof tokens on the way in and out of the endpoint -->
    <rect x="217" y="138" width="60" height="22" rx="6" class="d-ok"/>
    <circle cx="228" cy="149" r="5" class="d-ok"/>
    <text x="253.5" y="153" class="t mono center">proof</text>
    <rect x="483" y="138" width="60" height="22" rx="6" class="d-ok"/>
    <circle cx="494" cy="149" r="5" class="d-ok"/>
    <text x="519.5" y="153" class="t mono center">proof</text>

    <!-- A -> endpoint (5): batch + proof -->
    <line x1="202" y1="170" x2="290" y2="170" class="line a" marker-end="url(#stp-arrow-a)"/>
    <text x="247" y="186" class="t small center muted">batch + proof</text>
    <!-- endpoint -> B (4): delivers -->
    <line x1="468" y1="170" x2="556" y2="170" class="line c" marker-end="url(#stp-arrow-c)"/>
    <text x="513" y="186" class="t small center muted">delivers</text>

    <!-- Connector (6) -->
    <rect x="278" y="256" width="204" height="70" rx="10" class="d-money"/>
    <text x="380" y="278" class="t b center">Connector</text>
    <circle cx="299" cy="298" r="9" class="d-grey"/>
    <text x="299" y="302" class="t small center b">6</text>
    <text x="314" y="302" class="t small">pays on both ledgers;</text>
    <text x="314" y="318" class="t small">fined if it breaks its promise</text>
    <line x1="380" y1="256" x2="380" y2="218" class="line money" marker-end="url(#stp-arrow-money)"/>
    <text x="388" y="242" class="t small muted">reimbursed, with a margin</text>

    <!-- B -> A (6): exactly one reply -->
    <path d="M653,276 L653,358 L107,358 L107,278" class="line b dash" marker-end="url(#stp-arrow-b)"/>
    <text x="380" y="351" class="t small center muted">exactly one reply per accepted message</text>

    <!-- takeaway -->
    <text x="380" y="382" class="t take center">Safety lives on the ledgers; liveness depends on endpoints; money comes from connectors.</text>
  </svg>
</Figure>
