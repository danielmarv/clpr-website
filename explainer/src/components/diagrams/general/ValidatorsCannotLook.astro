---
/** Why Ledger A's validators cannot "go and look" at Ledger B: four validators ask the same question at the same moment and get different answers at different moments, so no line can be sealed. Final frame of the proposed animation, drawn static. Page-level claim (general sections 1 and 2); no spec anchor. */
import Figure from '@kse/components/Figure.astro';
---
<Figure
  lead="Same question, different answers."
  caption="Validators seal a line only when they all reach the same result on their own. Asking another network gives each of them a different answer at a different moment, so nothing can be sealed."
  kind="plain"
  minWidth={720}
>
  <svg viewBox="0 0 720 392" role="img" aria-label="Four validators of Ledger A, stacked on the left, each send the same question to Ledger B on the right at the same moment: is Bo's payment done? The replies come back differently: validator 1 hears done first, validator 2 hears not yet later, validator 3 hears nothing, validator 4 hears done last. Below, a red box says the new line on A is not written because the four copies disagree, next to a seal that is not lit.">
    <defs>
      <marker id="vcl-arrow-a" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--a)"/></marker>
      <marker id="vcl-arrow-ok" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--ok)"/></marker>
      <marker id="vcl-arrow-grey" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--text-3)"/></marker>
      <marker id="vcl-arrow-bad" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--bad)"/></marker>
    </defs>

    <text x="370" y="46" class="t small center muted">the same question, sent at the same moment</text>

    <!-- Validators of A -->
    <rect x="20" y="56" width="190" height="46" rx="8" class="d-a" />
    <text x="115" y="75" class="t b center">Validator 1 of A</text>
    <text x="115" y="92" class="t small center">asks B: is Bo's payment done?</text>

    <rect x="20" y="114" width="190" height="46" rx="8" class="d-a" />
    <text x="115" y="133" class="t b center">Validator 2 of A</text>
    <text x="115" y="150" class="t small center">asks the same</text>

    <rect x="20" y="172" width="190" height="46" rx="8" class="d-a" />
    <text x="115" y="191" class="t b center">Validator 3 of A</text>
    <text x="115" y="208" class="t small center">asks the same</text>

    <rect x="20" y="230" width="190" height="46" rx="8" class="d-a" />
    <text x="115" y="249" class="t b center">Validator 4 of A</text>
    <text x="115" y="266" class="t small center">asks the same</text>

    <!-- Ledger B -->
    <rect x="530" y="52" width="170" height="224" rx="12" class="d-b" />
    <text x="615" y="80" class="t b center">Ledger B</text>
    <text x="615" y="100" class="t small center">answers whoever asks,</text>
    <text x="615" y="116" class="t small center">whenever they ask</text>

    <!-- Questions out -->
    <line x1="212" y1="70" x2="528" y2="70" class="line a" marker-end="url(#vcl-arrow-a)" />
    <line x1="212" y1="128" x2="528" y2="128" class="line a" marker-end="url(#vcl-arrow-a)" />
    <line x1="212" y1="186" x2="528" y2="186" class="line a" marker-end="url(#vcl-arrow-a)" />
    <line x1="212" y1="244" x2="528" y2="244" class="line a" marker-end="url(#vcl-arrow-a)" />

    <!-- Replies back -->
    <line x1="528" y1="94" x2="214" y2="94" class="line ok" marker-end="url(#vcl-arrow-ok)" />
    <text x="370" y="89" class="t small center ok">"done", arrives first</text>

    <line x1="528" y1="152" x2="214" y2="152" class="line" marker-end="url(#vcl-arrow-grey)" />
    <text x="370" y="147" class="t small center muted">"not yet", arrives later</text>

    <line x1="528" y1="210" x2="400" y2="210" class="line bad dash" />
    <line x1="386" y1="204" x2="398" y2="216" class="line bad" />
    <line x1="386" y1="216" x2="398" y2="204" class="line bad" />
    <text x="300" y="205" class="t small center bad">nothing arrives</text>

    <line x1="528" y1="268" x2="214" y2="268" class="line ok" marker-end="url(#vcl-arrow-ok)" />
    <text x="370" y="263" class="t small center ok">"done", arrives last</text>

    <!-- Compare notes: no line -->
    <line x1="115" y1="278" x2="115" y2="298" class="line bad" marker-end="url(#vcl-arrow-bad)" />
    <text x="124" y="292" class="t small muted">compare notes</text>
    <rect x="20" y="300" width="300" height="46" rx="8" class="d-bad" />
    <text x="170" y="319" class="t b center">New line on A: not written</text>
    <text x="170" y="336" class="t small center">the four copies disagree, so nothing is sealed</text>

    <!-- Seal not lit -->
    <circle cx="372" cy="323" r="16" class="d-grey" stroke-dasharray="4 3" />
    <text x="372" y="329" class="t center muted" opacity="0.5">🔏</text>
    <text x="372" y="360" class="t small center muted">seal not lit</text>

    <!-- takeaway -->
    <text x="360" y="382" class="t take center">Sealing needs the same answer from every validator, alone; "go and look" cannot promise that.</text>
  </svg>
</Figure>
