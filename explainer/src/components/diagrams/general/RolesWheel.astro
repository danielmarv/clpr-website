---
/** The six roles around one channel and what each puts in: the user uses an application, the application developer picks a channel and a connector, the connector operator deposits a balance and a stake, the verifier developer writes the verifier, the endpoint operator fronts transaction fees, the service admin can close channels. Design §2.4 (participant roles) and §4.1 to §4.6. General page section 13; src/data/roles.json carries the same six. Static markup for scripts/preview-diagram.mjs. */
import Figure from '@kse/components/Figure.astro';
import { design } from '../../../lib/sources';
---
<Figure
  lead="Six roles around one channel."
  caption="A user uses an application; its developer picked a channel and a connector; the connector operator put up a balance and a stake; a verifier developer wrote the verifier the channel runs; endpoint operators front the fees and earn the margin; the service admin can configure the ledger, admit endpoints and close channels. Whoever would lose money is whoever does the checking."
  source={[{ label: 'design §2.4', href: design('24-participant-roles') }, { label: 'design §4', href: design('4-roles-and-operations') }]}
  kind="plain"
  minWidth={760}
>
  <svg viewBox="0 0 760 390" role="img" aria-label="A channel in the centre with six role boxes around it: user, application developer, connector operator, verifier developer, endpoint operator and service admin, each with a line to the channel and a note on what it puts in.">
    <line x1="380" y1="155" x2="380" y2="74" class="line" />
    <line x1="454" y1="167" x2="535" y2="144" class="line" />
    <line x1="454" y1="209" x2="535" y2="232" class="line" />
    <line x1="380" y1="221" x2="380" y2="296" class="line" />
    <line x1="306" y1="209" x2="225" y2="232" class="line" />
    <line x1="306" y1="167" x2="225" y2="144" class="line" />
    <rect x="306" y="155" width="148" height="66" rx="12" class="d-surface" />
    <text x="380" y="181" class="t b center">one channel</text>
    <text x="380" y="199" class="t small center">a verifier on each side,</text>
    <text x="380" y="213" class="t small center">a queue each way</text>
    <rect x="284" y="22" width="192" height="52" rx="10" class="d-grey" />
    <text x="380" y="43" class="t b center">User</text>
    <text x="380" y="61" class="t small center">uses an application</text>
    <rect x="510" y="92" width="232" height="52" rx="10" class="d-a" />
    <text x="626" y="113" class="t b center">Application developer</text>
    <text x="626" y="131" class="t small center">picks the channel and the connector</text>
    <rect x="510" y="232" width="232" height="52" rx="10" class="d-money" />
    <text x="626" y="253" class="t b center">Connector operator</text>
    <text x="626" y="271" class="t small center">a balance to pay, a stake to lose</text>
    <rect x="284" y="296" width="192" height="52" rx="10" class="d-ok" />
    <text x="380" y="317" class="t b center">Verifier developer</text>
    <text x="380" y="335" class="t small center">writes the verifier</text>
    <rect x="18" y="232" width="232" height="52" rx="10" class="d-c" />
    <text x="134" y="253" class="t b center">Endpoint operator</text>
    <text x="134" y="271" class="t small center">fronts the fees, earns the margin</text>
    <rect x="18" y="92" width="232" height="52" rx="10" class="d-grey" />
    <text x="134" y="113" class="t b center">Service admin</text>
    <text x="134" y="131" class="t small center">configures, admits endpoints, closes</text>
    <text x="380" y="378" class="t take center">Whoever would lose money is whoever does the checking.</text>
  </svg>
</Figure>
