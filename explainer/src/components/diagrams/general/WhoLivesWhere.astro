---
/** Where each member of the cast lives: state kept inside each ledger's CLPR Service (channel, connector, verifier and trust anchor), things that travel inside a bundle (messages and one state proof), and programs that act from outside (application, endpoint, admin). Draws from design §2.1 (terminology) and §3.1.0 (the CLPR Service holds all CLPR state). */
import Figure from '@kse/components/Figure.astro';
import { design } from '../../../lib/sources';
---
<Figure
  lead="Three kinds of cast member."
  caption="State that lives inside a ledger's CLPR Service (each channel with its trust anchor and verifier address, and the connectors' funds), things that travel (message, bundle, state proof), and the programs around them (an application on each ledger, the endpoint outside both, the admin). Nothing the endpoint carries is accepted on its word; it is checked inside the receiving service."
  source={[{ label: 'design §2.1', href: design('21-common-terminology') }, { label: 'design §3.1.0', href: design('310-the-clpr-service') }]}
  kind="spec"
  minWidth={760}
>
  <svg viewBox="0 0 760 414" role="img" aria-label="Two dashed frames, Ledger A on the left and Ledger B on the right. Inside each: an application and an admin at the top, a CLPR Service box holding the channel, the connector's funds and the verifier address with its trust anchor, and an endpoint straddling the bottom edge, half outside the ledger. Between the two endpoints a bundle box holds a data message, a reply, a housekeeping message and one state proof. Arrows: the application sends to the service, the endpoint reads the outbound queue, the bundle travels between endpoints, Ledger B's endpoint submits it as a transaction, and Ledger B's verifier checks the state proof.">
    <defs>
      <marker id="wlw-arrow-a" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--a)"/></marker>
      <marker id="wlw-arrow-b" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--b)"/></marker>
      <marker id="wlw-arrow-c" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--c)"/></marker>
      <marker id="wlw-arrow-ok" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--ok)"/></marker>
    </defs>

    <!-- ===== Ledger A (left frame) ===== -->
    <rect x="12" y="16" width="280" height="318" rx="12" class="line a dash"/>
    <text x="26" y="38" class="t b a">Ledger A</text>
    <text x="278" y="38" class="t mono muted end">acts from outside</text>

    <rect x="22" y="48" width="124" height="46" rx="8" class="d-a"/>
    <text x="84" y="68" class="t b center">Application</text>
    <text x="84" y="84" class="t small center">sends, receives</text>
    <rect x="158" y="48" width="124" height="46" rx="8" class="d-grey"/>
    <text x="220" y="68" class="t b center">Service admin</text>
    <text x="220" y="84" class="t small center">emergency brake</text>

    <rect x="22" y="116" width="260" height="146" rx="10" class="d-surface"/>
    <text x="152" y="136" class="t small center b">CLPR Service · the on-ledger core</text>
    <text x="152" y="150" class="t mono center muted">state lives here</text>
    <rect x="32" y="158" width="136" height="46" rx="8" class="d-grey"/>
    <text x="100" y="176" class="t small center b">Channel</text>
    <text x="100" y="192" class="t small center">queue + running hash</text>
    <rect x="176" y="158" width="96" height="46" rx="8" class="d-money"/>
    <text x="224" y="176" class="t small center b">Connector</text>
    <text x="224" y="192" class="t small center">funds + stake</text>
    <rect x="32" y="212" width="240" height="40" rx="8" class="d-ok"/>
    <text x="152" y="229" class="t small center b">Verifier address + trust anchor</text>
    <text x="152" y="244" class="t small center">address fixed; checks B's proofs</text>

    <rect x="22" y="306" width="260" height="70" rx="8" class="d-c"/>
    <text x="152" y="324" class="t b center">Endpoint</text>
    <text x="152" y="350" class="t small center">reads the outbound queue,</text>
    <text x="152" y="365" class="t small center">talks to B's endpoint</text>

    <!-- arrows inside A -->
    <line x1="84" y1="94" x2="84" y2="114" class="line a" marker-end="url(#wlw-arrow-a)"/>
    <text x="95" y="109" class="t small muted">sends</text>
    <line x1="152" y1="262" x2="152" y2="304" class="line c" marker-end="url(#wlw-arrow-c)"/>

    <!-- ===== Bundle (between the endpoints) ===== -->
    <rect x="318" y="190" width="124" height="164" rx="10" class="d-c"/>
    <text x="380" y="212" class="t b center">Bundle</text>
    <text x="380" y="226" class="t mono center muted">travels</text>
    <rect x="328" y="234" width="104" height="22" rx="6" class="d-grey"/>
    <text x="380" y="249" class="t small center">data message</text>
    <rect x="328" y="260" width="104" height="22" rx="6" class="d-grey"/>
    <text x="380" y="275" class="t small center">reply</text>
    <rect x="328" y="286" width="104" height="22" rx="6" class="d-grey"/>
    <text x="380" y="301" class="t small center">housekeeping</text>
    <rect x="328" y="318" width="104" height="26" rx="6" class="d-ok"/>
    <text x="380" y="335" class="t small center b">one state proof</text>

    <!-- endpoint A -> bundle -> endpoint B -->
    <line x1="282" y1="334" x2="316" y2="334" class="line c" marker-end="url(#wlw-arrow-c)"/>
    <line x1="442" y1="334" x2="476" y2="334" class="line c" marker-end="url(#wlw-arrow-c)"/>

    <!-- ===== Ledger B (right frame) ===== -->
    <rect x="468" y="16" width="280" height="318" rx="12" class="line b dash"/>
    <text x="734" y="38" class="t b b-col end">Ledger B</text>
    <text x="482" y="38" class="t mono muted">acts from outside</text>

    <rect x="478" y="48" width="124" height="46" rx="8" class="d-b"/>
    <text x="540" y="68" class="t b center">Application</text>
    <text x="540" y="84" class="t small center">receives, replies</text>
    <rect x="614" y="48" width="124" height="46" rx="8" class="d-grey"/>
    <text x="676" y="68" class="t b center">Service admin</text>
    <text x="676" y="84" class="t small center">emergency brake</text>

    <rect x="478" y="116" width="260" height="146" rx="10" class="d-surface"/>
    <text x="608" y="136" class="t small center b">CLPR Service · the on-ledger core</text>
    <text x="608" y="150" class="t mono center muted">state lives here</text>
    <rect x="488" y="158" width="136" height="46" rx="8" class="d-grey"/>
    <text x="556" y="176" class="t small center b">Channel</text>
    <text x="556" y="192" class="t small center">queue + running hash</text>
    <rect x="632" y="158" width="96" height="46" rx="8" class="d-money"/>
    <text x="680" y="176" class="t small center b">Connector</text>
    <text x="680" y="192" class="t small center">funds + stake</text>
    <rect x="488" y="212" width="240" height="40" rx="8" class="d-ok"/>
    <text x="608" y="229" class="t small center b">Verifier address + trust anchor</text>
    <text x="608" y="244" class="t small center">address fixed; checks A's proofs</text>

    <rect x="478" y="306" width="260" height="70" rx="8" class="d-c"/>
    <text x="608" y="324" class="t b center">Endpoint</text>
    <text x="608" y="359" class="t small center">submits it as an ordinary transaction</text>

    <!-- arrows inside B -->
    <line x1="608" y1="304" x2="608" y2="264" class="line c" marker-end="url(#wlw-arrow-c)"/>
    <line x1="540" y1="114" x2="540" y2="96" class="line b" marker-end="url(#wlw-arrow-b)"/>
    <text x="551" y="109" class="t small muted">delivers</text>
    <!-- verifier B checks the state proof in the bundle -->
    <path d="M488,236 C460,244 452,318 436,326" class="line ok" marker-end="url(#wlw-arrow-ok)"/>

    <!-- takeaway -->
    <text x="380" y="402" class="t take center">Nothing the endpoint carries is accepted on its word; all of it is checked inside the receiving service.</text>
  </svg>
</Figure>
