---
/** A mesh built from pairs: four ledgers, a channel between every two. The site's own illustration of what pairwise channels allow (design §2.1); each pair agrees separately, nothing sits in the middle, and joining means opening a channel to each partner you want. General page section 12. Static markup for scripts/preview-diagram.mjs. */
import Figure from '@kse/components/Figure.astro';
import { design } from '../../../lib/sources';
---
<Figure
  lead="A mesh is six pairs."
  caption="Four ledgers, a channel between every two: six agreements, each with its own verifiers and queues, and nothing in the middle. A fifth ledger joins by opening a channel to each partner it wants, and the existing four change nothing."
  source={[{ label: 'design §2.1', href: design('21-common-terminology') }]}
  kind="plain"
  minWidth={720}
>
  <svg viewBox="0 0 720 330" role="img" aria-label="Four ledgers at the corners, A, B, C and D, with a line between every pair: six channels. A note in the centre says nothing in the middle. A fifth ledger, dashed, sits to the right with a note saying it joins by opening its own channels.">
    <line x1="150" y1="80" x2="570" y2="80" class="line c" />
    <line x1="150" y1="80" x2="150" y2="250" class="line c" />
    <line x1="150" y1="80" x2="570" y2="250" class="line c" />
    <line x1="570" y1="80" x2="150" y2="250" class="line c" />
    <line x1="570" y1="80" x2="570" y2="250" class="line c" />
    <line x1="150" y1="250" x2="570" y2="250" class="line c" />
    <rect x="88" y="56" width="124" height="48" rx="10" class="d-a" />
    <text x="150" y="78" class="t b center">Ledger A</text>
    <text x="150" y="95" class="t small center">three channels</text>
    <rect x="508" y="56" width="124" height="48" rx="10" class="d-b" />
    <text x="570" y="78" class="t b center">Ledger B</text>
    <text x="570" y="95" class="t small center">three channels</text>
    <rect x="88" y="226" width="124" height="48" rx="10" class="d-c" />
    <text x="150" y="248" class="t b center">Ledger C</text>
    <text x="150" y="265" class="t small center">three channels</text>
    <rect x="508" y="226" width="124" height="48" rx="10" class="d-money" />
    <text x="570" y="248" class="t b center">Ledger D</text>
    <text x="570" y="265" class="t small center">three channels</text>
    <rect x="286" y="146" width="148" height="38" rx="8" class="d-surface" />
    <text x="360" y="162" class="t small center b">nothing in the middle</text>
    <text x="360" y="177" class="t small center">six pairs, six verifiers each way</text>
    <rect x="636" y="140" width="76" height="48" rx="10" class="d-surface" stroke-dasharray="6 5" />
    <text x="674" y="160" class="t b center">Ledger E</text>
    <text x="674" y="176" class="t small center">joining</text>
    <line x1="636" y1="152" x2="634" y2="104" class="line dash" />
    <line x1="636" y1="176" x2="634" y2="226" class="line dash" />
    <text x="674" y="206" class="t small center">opens a channel</text>
    <text x="674" y="220" class="t small center">to each partner</text>
    <text x="360" y="316" class="t take center">every pair agrees on its own; nobody has to agree for everyone.</text>
  </svg>
</Figure>
