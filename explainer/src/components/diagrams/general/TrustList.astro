---
/** The short list of what an application using a channel trusts (design §2.3): its own ledger, the CLPR software on both ledgers, the other ledger's validators, the application on the other side, and the channel's verifier, which is the one entry the application must check itself. The endpoint and the connector sit apart: relied on for delivery and payment, not for safety. */
import Figure from '@kse/components/Figure.astro';
import { design } from '../../../lib/sources';
---
<Figure
  lead="Trust, narrowed, not removed."
  caption="Every entry is named in advance and can be inspected. Anyone can create a channel with any verifier, so choosing a channel is choosing to trust its verifier."
  source={[{ label: 'design §2.3', href: design('23-trust-model') }]}
  kind="spec"
  minWidth={760}
>
  <svg viewBox="0 0 760 374" role="img" aria-label="Your application on Ledger A, on the left, trusts a short list drawn as a column of six entries: Ledger A, the CLPR software on A, the CLPR software on B, Ledger B's validators, the application on B, and the channel's verifier, which is marked as the one entry you must check yourself. Apart on the right, an endpoint box and a connector box, labelled relied on but not for safety: the endpoint keeps messages moving and the connector pays; neither can forge.">
    <defs>
      <marker id="tl-arrow-a" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--a)"/></marker>
      <marker id="tl-arrow-ok" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--ok)"/></marker>
    </defs>

    <!-- Your application -->
    <rect x="20" y="130" width="180" height="72" rx="8" class="d-a" />
    <text x="110" y="154" class="t b center">Your application</text>
    <text x="110" y="172" class="t small center">on Ledger A, the one</text>
    <text x="110" y="188" class="t small center">sending the message</text>
    <line x1="200" y1="166" x2="258" y2="166" class="line a" marker-end="url(#tl-arrow-a)" />
    <text x="229" y="158" class="t small center muted">trusts</text>

    <!-- The list -->
    <rect x="260" y="20" width="300" height="320" rx="12" class="d-surface" />
    <text x="410" y="42" class="t b center">The short list</text>
    <text x="410" y="58" class="t small center muted">what safety rests on; all inspectable</text>

    <rect x="272" y="68" width="276" height="38" rx="8" class="d-a" />
    <text x="410" y="84" class="t b center">Ledger A</text>
    <text x="410" y="99" class="t small center">its own validators</text>

    <rect x="272" y="112" width="276" height="38" rx="8" class="d-a" />
    <text x="410" y="128" class="t b center">CLPR software on A</text>
    <text x="410" y="143" class="t small center">the CLPR Service on your side</text>

    <rect x="272" y="156" width="276" height="38" rx="8" class="d-b" />
    <text x="410" y="172" class="t b center">CLPR software on B</text>
    <text x="410" y="187" class="t small center">the CLPR Service on the other side</text>

    <rect x="272" y="200" width="276" height="38" rx="8" class="d-b" />
    <text x="410" y="216" class="t b center">Ledger B's validators</text>
    <text x="410" y="231" class="t small center">the other ledger's consensus</text>

    <rect x="272" y="244" width="276" height="38" rx="8" class="d-b" />
    <text x="410" y="260" class="t b center">The application on B</text>
    <text x="410" y="275" class="t small center">whoever receives the message</text>

    <rect x="272" y="288" width="276" height="38" rx="8" class="d-ok" />
    <text x="410" y="304" class="t b center">The channel's verifier</text>
    <text x="410" y="319" class="t small center">chosen by whoever created the channel</text>

    <!-- The verifier is the entry you check -->
    <line x1="548" y1="307" x2="572" y2="307" class="line ok" marker-end="url(#tl-arrow-ok)" />
    <text x="580" y="303" class="t small ok">the one entry you must</text>
    <text x="580" y="317" class="t small ok">check yourself</text>

    <!-- The endpoint and the connector, apart: relied on, not for safety -->
    <text x="664" y="42" class="t small center muted">not on the list</text>
    <rect x="580" y="52" width="168" height="70" rx="8" class="d-grey" />
    <text x="664" y="76" class="t b center">Endpoint</text>
    <text x="664" y="94" class="t small center">keeps messages moving</text>
    <text x="664" y="110" class="t small center muted">can delay, cannot forge</text>
    <rect x="580" y="132" width="168" height="70" rx="8" class="d-grey" />
    <text x="664" y="156" class="t b center">Connector</text>
    <text x="664" y="174" class="t small center">pays for the message</text>
    <text x="664" y="190" class="t small center muted">can refuse, cannot forge</text>

    <!-- takeaway -->
    <text x="380" y="362" class="t take center">Narrowed, not removed: endpoints and connectors are off the list; the verifier is on it, unvetted by CLPR.</text>
  </svg>
</Figure>
