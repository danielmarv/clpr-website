---
/** One connector_id registered on both ledgers: authorizes on the source, pays on the destination; spec §2.2 and §3.3, design §3.3. */
import Figure from '@kse/components/Figure.astro';
import { design, spec } from '../../../lib/sources';
---
<Figure
  lead="Bilateral by construction."
  caption="The same derived identity is registered on both ledgers of a channel: on the source it authorizes the message, on the destination it pays for executing it. Storage is keyed by (channel_id, connector_id), so a squatter on a third ledger affects only channels there."
  source={[{ label: 'spec §2.2', href: spec('22-connector') }, { label: 'spec §3.3', href: spec('33-connector-authorization-interface') }, { label: 'design §3.3', href: design('33-payment--routing-layer') }]}
  kind="spec"
  minWidth={740}
>
  <svg viewBox="0 0 740 388" role="img" aria-label="An application on ledger A calls sendMessage with a connector_id. The service asks the connector on A to authorize the message; it returns true. The Data Message carries the connector_id over the channel; the connector with the same id on ledger B is looked up, charged, and then the application on B is called. If no connector with that id is registered on B, the result is CONNECTOR_NOT_FOUND, an error reply goes home, and the source connector is slashed.">
    <defs>
      <marker id="bc-arrow-money" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--money)" /></marker>
      <marker id="bc-arrow-c" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--c)" /></marker>
      <marker id="bc-arrow-bad" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--bad)" /></marker>
    </defs>

    <!-- applications -->
    <rect x="16" y="16" width="190" height="64" rx="8" class="d-a" />
    <text x="111" y="38" class="t b center">Application on A</text>
    <text x="111" y="56" class="t mono center">sendMessage(channel_id,</text>
    <text x="111" y="70" class="t mono center">connector_id, …)</text>

    <rect x="534" y="16" width="190" height="64" rx="8" class="d-b" />
    <text x="629" y="38" class="t b center">Application on B</text>
    <text x="629" y="56" class="t small center">called only after</text>
    <text x="629" y="70" class="t small center">the connector pays</text>

    <!-- the service asks the connector on A -->
    <line x1="50" y1="80" x2="50" y2="148" class="line money" marker-end="url(#bc-arrow-money)" />
    <text x="60" y="98" class="t small">the service asks</text>
    <text x="60" y="112" class="t mono">authorizeMessage(sender,</text>
    <text x="60" y="126" class="t mono">target_application,</text>
    <text x="60" y="140" class="t mono">message_size, message_data)</text>

    <!-- connector on A -->
    <rect x="16" y="150" width="190" height="84" rx="8" class="d-money" />
    <text x="111" y="172" class="t b center">Connector on A</text>
    <text x="111" y="190" class="t mono center">connector_id =</text>
    <text x="111" y="204" class="t mono center">keccak256(channel_id ‖</text>
    <text x="111" y="218" class="t mono center">public_key ‖ salt)</text>

    <line x1="206" y1="186" x2="268" y2="186" class="line money" marker-end="url(#bc-arrow-money)" />
    <text x="237" y="178" class="t mono center">true</text>
    <text x="237" y="200" class="t small center">B can pay</text>

    <!-- channel -->
    <rect x="270" y="150" width="200" height="72" rx="8" class="d-c" />
    <text x="370" y="172" class="t b center">Channel</text>
    <text x="370" y="190" class="t mono center">Data Message · connector_id</text>
    <text x="370" y="208" class="t small center">key: (channel_id, connector_id)</text>

    <line x1="470" y1="186" x2="532" y2="186" class="line c" marker-end="url(#bc-arrow-c)" />
    <text x="501" y="178" class="t small center">look up</text>

    <!-- connector on B -->
    <rect x="534" y="150" width="190" height="84" rx="8" class="d-money" />
    <text x="629" y="172" class="t b center">Connector on B</text>
    <text x="629" y="190" class="t mono center">same connector_id</text>
    <text x="629" y="206" class="t small center">balance pays execution,</text>
    <text x="629" y="220" class="t small center">locked_stake is slashable</text>

    <line x1="600" y1="150" x2="600" y2="82" class="line money" marker-end="url(#bc-arrow-money)" />
    <text x="610" y="108" class="t small">charged,</text>
    <text x="610" y="122" class="t small">then called</text>

    <!-- missing counterpart -->
    <path d="M430,222 L532,292" class="line bad" marker-end="url(#bc-arrow-bad)" />
    <text x="456" y="268" class="t small end bad">no counterpart on B</text>

    <rect x="534" y="266" width="190" height="78" rx="8" class="d-bad" />
    <text x="629" y="288" class="t b center">Not registered on B</text>
    <text x="629" y="306" class="t mono center">CONNECTOR_NOT_FOUND</text>
    <text x="629" y="322" class="t small center">error reply goes home;</text>
    <text x="629" y="336" class="t small center">source connector slashed</text>

    <text x="370" y="372" class="t take center">Registered on one side only: authorizes on the source, CONNECTOR_NOT_FOUND on the destination.</text>
  </svg>
</Figure>
