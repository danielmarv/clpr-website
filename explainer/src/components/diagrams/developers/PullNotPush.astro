---
/** One sync between two endpoints: the receiver says how far it has got, the sender answers with exactly the missing messages plus a proof; the request itself is unproven and cannot change any ledger (spec §1.5; design §3.1.4). */
import Figure from '@kse/components/Figure.astro';
import { design, spec } from '../../../lib/sources';
---
<Figure
  lead="Ask, then receive."
  caption="Each endpoint tells its peer how far it has got and gets back exactly the messages after that point, with a proof. The request carries no proof and needs none, because it cannot change anything."
  source={[
    { label: 'spec §1.5', href: spec('15-sync-protocol') },
    { label: 'design §3.1.4', href: design('314-endpoint-communication-protocol') },
  ]}
  kind="spec"
  minWidth={640}
>
  <svg viewBox="0 0 640 350" role="img" aria-label="Two endpoints as vertical lanes. The endpoint on B, on the right, tells the endpoint on A, on the left, that it has received up to message 41; the request is cheap, unproven and changes nothing. The endpoint on A answers with messages 42, 43 and 44 plus a proof sealed by Ledger A. The endpoint on B dry-runs the bundle and submits it to Ledger B, below it, which throws away anything it already has.">
    <defs>
      <marker id="pnp-arrow-c" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--c)" /></marker>
      <marker id="pnp-arrow-ok" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--ok)" /></marker>
    </defs>

    <!-- lanes: Ledger A's endpoint on the left, Ledger B's on the right -->
    <rect x="40" y="20" width="200" height="52" rx="8" class="d-c" />
    <text x="140" y="41" class="t b center">Endpoint on A</text>
    <text x="140" y="58" class="t small center">holds A's outbound queue: #42 #43 #44</text>
    <rect x="400" y="20" width="200" height="52" rx="8" class="d-c" />
    <text x="500" y="41" class="t b center">Endpoint on B</text>
    <text x="500" y="58" class="t small center">"I have received up to #41"</text>
    <line x1="140" y1="72" x2="140" y2="230" class="line dash" />
    <line x1="500" y1="72" x2="500" y2="200" class="line dash" />

    <!-- 1 request, right to left -->
    <circle cx="480" cy="100" r="9" class="d-grey" /><text x="480" y="104" class="t small center b">1</text>
    <line x1="464" y1="100" x2="146" y2="100" class="line c dash" marker-end="url(#pnp-arrow-c)" />
    <text x="305" y="92" class="t small center">request: "give me everything after #41"</text>
    <text x="305" y="116" class="t small center muted">cheap, unproven, changes nothing</text>

    <!-- 2 bundle, left to right -->
    <circle cx="160" cy="175" r="9" class="d-grey" /><text x="160" y="179" class="t small center b">2</text>
    <line x1="176" y1="175" x2="218" y2="175" class="line ok" marker-end="url(#pnp-arrow-ok)" />
    <rect x="220" y="150" width="200" height="50" rx="8" class="d-ok" />
    <rect x="228" y="157" width="26" height="22" rx="6" class="d-surface" /><circle cx="241" cy="168" r="5" class="d-ok" />
    <text x="260" y="172" class="t b">#42 #43 #44 + proof</text>
    <text x="320" y="193" class="t small center">sealed by Ledger A</text>
    <line x1="420" y1="175" x2="494" y2="175" class="line ok" marker-end="url(#pnp-arrow-ok)" />
    <text x="320" y="140" class="t small center">exactly what was missing, nothing more</text>

    <!-- 3 submit -->
    <circle cx="480" cy="224" r="9" class="d-grey" /><text x="480" y="228" class="t small center b">3</text>
    <line x1="500" y1="200" x2="500" y2="267" class="line c" marker-end="url(#pnp-arrow-c)" />
    <text x="464" y="228" class="t small end">submit, after a local dry run</text>

    <rect x="400" y="270" width="200" height="52" rx="8" class="d-b" />
    <text x="500" y="291" class="t b center">Ledger B</text>
    <text x="500" y="308" class="t small center">throws away what it already has</text>
    <text x="380" y="289" class="t small muted end">a wrong number at worst produces</text>
    <text x="380" y="304" class="t small muted end">a duplicate, which is discarded here</text>

    <!-- takeaway -->
    <text x="320" y="342" class="t take center">Nothing is pushed. The request cannot change any ledger; at worst it causes a duplicate.</text>
  </svg>
</Figure>
