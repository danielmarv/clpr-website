---
/** Who acts, in what order, when a verifier must be replaced: both a compromise and a proof format upgrade end in a new channel; design §4.7 and §5. */
import Figure from '@kse/components/Figure.astro';
import { design } from '../../../lib/sources';
---
<Figure
  lead="Every verifier change is a new channel."
  caption="The verifier developer publishes, the connector operator registers, the application developer migrates and the admin closes the old channel. For a compromise the close comes first and in-flight messages may end UNRESOLVED; for a planned format upgrade the close comes last, after the source has kept the old format alive long enough to migrate."
  source={[{ label: 'design §4.7', href: design('47-cross-role-scenarios') }, { label: 'design §5', href: design('5-recovery-scenarios') }]}
  kind="spec"
  minWidth={740}
>
  <svg viewBox="0 0 740 384" role="img" aria-label="A trigger, either a security advisory or a proof format change, reaches the verifier developer and the CLPR Service admin. The verifier developer publishes a patched or new-format verifier; the connector operator registers a new channel with it and a connector on both ledgers; the application developer migrates to the new channel. The admin closes the old channel, at once for a compromise and after migration for an upgrade; in-flight messages finish on the old channel while new traffic moves to the new one.">
    <defs>
      <marker id="ncm-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--text-3)" /></marker>
      <marker id="ncm-arrow-ok" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--ok)" /></marker>
      <marker id="ncm-arrow-money" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--money)" /></marker>
      <marker id="ncm-arrow-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--a)" /></marker>
      <marker id="ncm-arrow-bad" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--bad)" /></marker>
    </defs>

    <!-- row 1: trigger, verifier developer, connector operator -->
    <rect x="24" y="22" width="184" height="66" rx="8" class="d-surface" />
    <text x="116" y="44" class="t b center">Trigger</text>
    <text x="116" y="62" class="t small center">compromise: security advisory</text>
    <text x="116" y="78" class="t small center">upgrade: proof format change</text>
    <circle cx="24" cy="22" r="9" class="d-grey" /><text x="24" y="26" class="t small center b">1</text>

    <line x1="208" y1="55" x2="276" y2="55" class="line" marker-end="url(#ncm-arrow)" />

    <rect x="278" y="22" width="184" height="66" rx="8" class="d-ok" />
    <text x="370" y="44" class="t b center">Verifier Developer</text>
    <text x="370" y="62" class="t small center">publishes a patched or</text>
    <text x="370" y="78" class="t small center">new-format verifier</text>
    <circle cx="278" cy="22" r="9" class="d-grey" /><text x="278" y="26" class="t small center b">2</text>

    <line x1="462" y1="55" x2="530" y2="55" class="line ok" marker-end="url(#ncm-arrow-ok)" />

    <rect x="532" y="22" width="184" height="66" rx="8" class="d-money" />
    <text x="624" y="44" class="t b center">Connector Operator</text>
    <text x="624" y="62" class="t small center">new channel with it;</text>
    <text x="624" y="78" class="t small center">connector on both ledgers</text>
    <circle cx="532" cy="22" r="9" class="d-grey" /><text x="532" y="26" class="t small center b">3</text>

    <!-- down to row 2 -->
    <line x1="116" y1="88" x2="116" y2="134" class="line" marker-end="url(#ncm-arrow)" />
    <line x1="624" y1="88" x2="624" y2="134" class="line money" marker-end="url(#ncm-arrow-money)" />
    <text x="632" y="115" class="t small">registers</text>

    <!-- row 2: admin, old channel, new channel -->
    <rect x="24" y="136" width="184" height="80" rx="8" class="d-grey" />
    <text x="116" y="158" class="t b center">CLPR Service Admin</text>
    <text x="116" y="176" class="t mono center">closeChannel(old)</text>
    <text x="116" y="192" class="t small center">compromise: at once;</text>
    <text x="116" y="206" class="t small center">upgrade: after migration</text>

    <line x1="208" y1="176" x2="276" y2="176" class="line bad" marker-end="url(#ncm-arrow-bad)" />
    <text x="242" y="168" class="t small center">closes</text>

    <rect x="278" y="136" width="184" height="80" rx="8" class="d-bad" />
    <text x="370" y="158" class="t b center">Old channel</text>
    <text x="370" y="176" class="t small center">in-flight messages finish;</text>
    <text x="370" y="194" class="t mono center">CLOSING → CLOSED</text>
    <text x="370" y="208" class="t small center">its verifier cannot change</text>

    <line x1="462" y1="176" x2="530" y2="176" class="line dash" marker-end="url(#ncm-arrow)" />

    <rect x="532" y="136" width="184" height="80" rx="8" class="d-ok" />
    <text x="624" y="158" class="t b center">New channel</text>
    <text x="624" y="176" class="t small center">correct verifier;</text>
    <text x="624" y="194" class="t mono center">ACTIVE</text>
    <text x="624" y="208" class="t small center">new traffic goes here</text>

    <!-- row 3: application developer -->
    <line x1="624" y1="262" x2="624" y2="218" class="line a" marker-end="url(#ncm-arrow-a)" />
    <text x="632" y="244" class="t small">migrates</text>

    <rect x="532" y="262" width="184" height="60" rx="8" class="d-a" />
    <text x="624" y="284" class="t b center">Application Developer</text>
    <text x="624" y="302" class="t mono center">channel_id · connector_id</text>
    <text x="624" y="316" class="t small center">switch and migrate users</text>
    <circle cx="532" cy="262" r="9" class="d-grey" /><text x="532" y="266" class="t small center b">4</text>

    <text x="370" y="352" class="t take center">Verifiers are fixed for a channel's life, so every fix is a new channel.</text>
    <text x="370" y="368" class="t take center">For a compromise, the window of vulnerability is between discovery and close.</text>
  </svg>
</Figure>
