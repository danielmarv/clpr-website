---
/** What each production proof points at: a Hiero proof walks from a TSS-signed SHA-384 block root down to the Channel leaf (tag 482) and ClprMessageValue leaves (tag 498); a QBFT proof walks from a header with committed seals through the EIP-1186 account proof to five storage slots. Both end in the sync data and anchor hash the service checks. Draws on the page's verifier table and the pinned hiero/state_proof.md and qbft/state_proof.md. */
import Figure from '@kse/components/Figure.astro';
import { pinned } from '../../../lib/sources';
---
<Figure
  lead="Two state trees, one question."
  caption="A Hiero proof walks from a threshold-signed block root down to the channel and message leaves; a QBFT proof walks from a sealed header through the account proof to five storage slots. Both deliver the same sync data and anchor hash for the service's own checks."
  source={[{ label: 'hiero/state_proof.md', href: pinned('clpr-spec', 'verifiers/hiero/state_proof.md') }, { label: 'qbft/state_proof.md', href: pinned('clpr-spec', 'verifiers/qbft/state_proof.md') }]}
  kind="spec"
  minWidth={760}
>
  <svg viewBox="0 0 760 436" role="img" aria-label="Two columns. Left, Hiero: a TSS signature box (BLS12-381 aggregate over the block root, checked against the stored ledger_id) signs a block root box (48-byte SHA-384 Merkle root with domain prefixes), from which Merkle paths lead to a Channel leaf, tag 482, holding the queue metadata, and a ClprMessageValue leaf, tag 498, one per message with payload and running hash. Right, QBFT: a block header with committed seals in extraData, ECDSA signers recovered and checked against the validator set hash, leads via keccak to stateRoot with the EIP-1186 account proof for the CLPR Service, and via storage proofs to five storage slots: status + nextMessageId, ackedMessageId + receivedMessageId, sentRunningHash, receivedRunningHash, and the anchor message's running hash. Both columns feed one box at the bottom: what verifyBundle returns to the service, sync_data, messages, anchor_message_id and anchor_running_hash.">
    <defs>
      <marker id="tst-arrow-ok" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--ok)"/></marker>
      <marker id="tst-arrow-a" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--a)"/></marker>
      <marker id="tst-arrow-b" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--b)"/></marker>
    </defs>

    <!-- Column headings -->
    <text x="185" y="28" class="t b center a">Hiero (TSS / hinTS)</text>
    <text x="575" y="28" class="t b center b-col">QBFT (Besu)</text>

    <!-- Hiero: signature over the block root -->
    <rect x="20" y="40" width="330" height="64" rx="8" class="d-ok"/>
    <text x="32" y="60" class="t b">TSS signature</text>
    <text x="32" y="76" class="t small">BLS12-381 aggregate over the block root,</text>
    <text x="32" y="90" class="t small">checked against the stored ledger_id</text>
    <line x1="185" y1="104" x2="185" y2="122" class="line ok" marker-end="url(#tst-arrow-ok)"/>
    <text x="193" y="117" class="t small muted">signs</text>

    <!-- Hiero: block root -->
    <rect x="20" y="124" width="330" height="64" rx="8" class="d-a"/>
    <text x="32" y="144" class="t b">block root</text>
    <text x="32" y="160" class="t mono">48-byte SHA-384 Merkle root</text>
    <text x="32" y="176" class="t mono">domain prefixes 0x00 · 0x01 · 0x02</text>
    <line x1="99" y1="188" x2="99" y2="212" class="line a" marker-end="url(#tst-arrow-a)"/>
    <line x1="271" y1="188" x2="271" y2="212" class="line a" marker-end="url(#tst-arrow-a)"/>
    <text x="185" y="206" class="t small center muted">Merkle paths</text>

    <!-- Hiero: the two leaves -->
    <rect x="20" y="214" width="158" height="90" rx="8" class="d-a"/>
    <text x="32" y="234" class="t b">Channel leaf</text>
    <text x="32" y="250" class="t mono">tag 482</text>
    <text x="32" y="266" class="t small">queue metadata: ids,</text>
    <text x="32" y="280" class="t small">running hashes, status</text>
    <rect x="192" y="214" width="158" height="90" rx="8" class="d-a"/>
    <text x="204" y="234" class="t b">ClprMessageValue</text>
    <text x="204" y="250" class="t mono">tag 498</text>
    <text x="204" y="266" class="t small">one leaf per message:</text>
    <text x="204" y="280" class="t small">payload + running hash</text>

    <!-- QBFT: sealed header -->
    <rect x="410" y="40" width="330" height="64" rx="8" class="d-ok"/>
    <text x="422" y="60" class="t b">QBFT block header</text>
    <text x="422" y="76" class="t small">committed seals in extraData; ECDSA signers</text>
    <text x="422" y="90" class="t small">recovered, threshold vs the validator set hash</text>
    <line x1="575" y1="104" x2="575" y2="122" class="line b" marker-end="url(#tst-arrow-b)"/>
    <text x="583" y="117" class="t small muted">keccak the header</text>

    <!-- QBFT: stateRoot and the account proof -->
    <rect x="410" y="124" width="330" height="64" rx="8" class="d-b"/>
    <text x="422" y="144" class="t b">stateRoot</text>
    <text x="422" y="160" class="t mono">EIP-1186 account proof for the CLPR Service</text>
    <text x="422" y="176" class="t small">walked to the account's storageRoot</text>
    <line x1="575" y1="188" x2="575" y2="212" class="line b" marker-end="url(#tst-arrow-b)"/>
    <text x="583" y="204" class="t small muted">storage proofs</text>

    <!-- QBFT: the five slots -->
    <rect x="410" y="214" width="330" height="90" rx="8" class="d-b"/>
    <text x="422" y="234" class="t b">five storage slots</text>
    <text x="422" y="250" class="t mono">status + nextMessageId</text>
    <text x="422" y="264" class="t mono">ackedMessageId + receivedMessageId</text>
    <text x="422" y="278" class="t mono">sentRunningHash · receivedRunningHash</text>
    <text x="422" y="292" class="t mono">the anchor message's running hash</text>

    <!-- Both end in the same values -->
    <path d="M20,306 V312 H350 V306" class="line a"/>
    <line x1="185" y1="312" x2="262" y2="334" class="line ok" marker-end="url(#tst-arrow-ok)"/>
    <line x1="575" y1="304" x2="498" y2="334" class="line ok" marker-end="url(#tst-arrow-ok)"/>
    <rect x="200" y="336" width="360" height="66" rx="8" class="d-ok"/>
    <text x="380" y="356" class="t b center">what verifyBundle returns to the service</text>
    <text x="380" y="374" class="t mono center">sync_data · messages</text>
    <text x="380" y="390" class="t mono center">anchor_message_id · anchor_running_hash</text>

    <!-- takeaway -->
    <text x="380" y="424" class="t take center">Different trees, different signatures, the same handful of values at the end.</text>
  </svg>
</Figure>
