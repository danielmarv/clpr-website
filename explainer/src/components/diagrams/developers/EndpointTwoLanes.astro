---
/** The clpr-endpoint relay as two lanes: outbound (poll the local node, build the payload, pick a peer, stream it) and inbound (decode the peer's bundle, trim what is already accepted, dry-run submitBundle, sign and pay). Draws on the page's endpoint paragraph and the repository's docs/architecture.md and docs/sync-protocol.md. */
import Figure from '@kse/components/Figure.astro';
import { pinned } from '../../../lib/sources';
---
<Figure
  lead="Two lanes through one relay."
  caption="On the way out the relay notices the queue grow, builds a payload with a proof and streams it to a chosen peer. On the way in it decodes the peer's bundle, drops messages its ledger already accepted so a duplicate cannot sink the bundle as a replay, simulates submitBundle with eth_call, and only then signs and pays."
  source={[{ label: 'endpoint docs/architecture.md', href: pinned('clpr-endpoint', 'docs/architecture.md') }, { label: 'docs/sync-protocol.md', href: pinned('clpr-endpoint', 'docs/sync-protocol.md') }]}
  kind="impl"
  minWidth={760}
>
  <svg viewBox="0 0 760 414" role="img" aria-label="A tall Local EVM node box on the left and a tall Peer endpoint box on the right, with two horizontal lanes between them. The outbound lane runs left to right through three boxes: a state-change poller that watches nextMessageId, a sync task that reads the new messages and builds the payload with QbftBundleConstructor, and a peer picker that prefers never-failed, then recently successful, then round-robin peers. The inbound lane runs right to left through a decode and trim box, a green dry-run box where EvmBundlePreVerifier simulates submitBundle with eth_call, and a submitter that signs submitBundle client-side with EIP-1559 and polls for the receipt. A note at the bottom names the always-plaintext info port 9546.">
    <defs>
      <marker id="ep-lanes-arrow-b" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--b)"/></marker>
      <marker id="ep-lanes-arrow-c" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--c)"/></marker>
      <marker id="ep-lanes-arrow-ok" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--ok)"/></marker>
    </defs>

    <!-- local node, left -->
    <rect x="12" y="70" width="84" height="234" rx="10" class="d-b"/>
    <text x="54" y="92" class="t b center">Local EVM</text>
    <text x="54" y="109" class="t b center">node</text>
    <text x="54" y="134" class="t mono center">JSON-RPC</text>
    <text x="54" y="162" class="t mono center">getChannel</text>
    <text x="54" y="178" class="t small center">is polled;</text>
    <text x="54" y="194" class="t small center">no event</text>
    <text x="54" y="210" class="t small center">subscription</text>

    <!-- peer endpoint, right -->
    <rect x="664" y="70" width="84" height="234" rx="10" class="d-c"/>
    <text x="706" y="92" class="t b center">Peer</text>
    <text x="706" y="109" class="t b center">endpoint</text>
    <text x="706" y="134" class="t small center">sync RPC</text>
    <text x="706" y="150" class="t mono center">port 9545</text>
    <text x="706" y="178" class="t small center">mTLS when on:</text>
    <text x="706" y="194" class="t small center">P-384 CA,</text>
    <text x="706" y="210" class="t small center">Ed25519 leaf</text>

    <!-- outbound lane -->
    <text x="120" y="58" class="t b">Outbound · the local queue grew</text>
    <line x1="96" y1="106" x2="118" y2="106" class="line b" marker-end="url(#ep-lanes-arrow-b)"/>
    <rect x="120" y="70" width="156" height="72" rx="8" class="d-c"/>
    <text x="132" y="90" class="t b">State-change poller</text>
    <text x="132" y="107" class="t small">one per channel; wakes</text>
    <text x="132" y="123" class="t small">the sync task when</text>
    <text x="132" y="138" class="t mono">nextMessageId</text>
    <text x="222" y="138" class="t small">advances</text>
    <line x1="276" y1="106" x2="298" y2="106" class="line c" marker-end="url(#ep-lanes-arrow-c)"/>
    <rect x="300" y="70" width="156" height="72" rx="8" class="d-c"/>
    <text x="312" y="90" class="t b">Sync task</text>
    <text x="312" y="107" class="t small">reads the new messages,</text>
    <text x="312" y="123" class="t small">builds payload and proof</text>
    <text x="312" y="138" class="t mono">QbftBundleConstructor</text>
    <line x1="456" y1="106" x2="478" y2="106" class="line c" marker-end="url(#ep-lanes-arrow-c)"/>
    <rect x="480" y="70" width="156" height="72" rx="8" class="d-c"/>
    <text x="492" y="90" class="t b">Peer picker</text>
    <text x="492" y="107" class="t small">never-failed, then</text>
    <text x="492" y="123" class="t small">recently-successful,</text>
    <text x="492" y="138" class="t small">then round-robin</text>
    <line x1="636" y1="106" x2="662" y2="106" class="line c" marker-end="url(#ep-lanes-arrow-c)"/>

    <!-- inbound lane, right to left -->
    <text x="120" y="220" class="t b">Inbound · a peer's bundle arrived</text>
    <line x1="664" y1="268" x2="638" y2="268" class="line c" marker-end="url(#ep-lanes-arrow-c)"/>
    <rect x="480" y="232" width="156" height="72" rx="8" class="d-c"/>
    <text x="492" y="252" class="t b">Decode and trim</text>
    <text x="492" y="269" class="t small">parses the peer's bundle;</text>
    <text x="492" y="285" class="t small">drops messages the ledger</text>
    <text x="492" y="300" class="t small">already accepted</text>
    <line x1="480" y1="268" x2="458" y2="268" class="line c" marker-end="url(#ep-lanes-arrow-c)"/>
    <rect x="300" y="232" width="156" height="72" rx="8" class="d-ok"/>
    <text x="312" y="252" class="t b">Dry-run</text>
    <text x="312" y="269" class="t mono">EvmBundlePreVerifier</text>
    <text x="312" y="285" class="t small">simulates submitBundle</text>
    <text x="312" y="300" class="t small">with eth_call first</text>
    <line x1="300" y1="268" x2="278" y2="268" class="line ok" marker-end="url(#ep-lanes-arrow-ok)"/>
    <rect x="120" y="232" width="156" height="72" rx="8" class="d-c"/>
    <text x="132" y="252" class="t b">Submitter</text>
    <text x="132" y="269" class="t small">signs submitBundle</text>
    <text x="132" y="285" class="t small">client-side · EIP-1559</text>
    <text x="132" y="300" class="t small">polls for the receipt</text>
    <line x1="120" y1="268" x2="98" y2="268" class="line b" marker-end="url(#ep-lanes-arrow-b)"/>

    <!-- info port -->
    <rect x="120" y="330" width="516" height="34" rx="8" class="d-surface"/>
    <text x="132" y="352" class="t mono">info port 9546</text>
    <text x="246" y="352" class="t small muted">always plaintext · chain-verifiable public data</text>

    <!-- takeaway -->
    <text x="380" y="398" class="t take center">Out: poll, build, pick a peer, send. In: decode, trim, dry-run, then sign and pay.</text>
  </svg>
</Figure>
