---
/** The order spec §8.5 mandates when the service hands control to arbitrary code: all Channel state for a message is updated before onClprMessage is called, and every state-modifying function carries a reentrancy guard. Draws on spec §8.5 and the design document's Ethereum reentrancy note in §3.3.3. */
import Figure from '@kse/components/Figure.astro';
import { design, spec } from '../../../lib/sources';
---
<Figure
  lead="Checks, effects, then the application."
  caption="Reentrancy guards and the checks-effects-interactions order are required: all Channel state for a message updated before control passes to the target application. The pinned reference contracts rely on the reentrancy guard; they update the received counters after dispatch and charge the connector after the call, from the gas used."
  source={[{ label: 'spec §8.5', href: spec('85-reentrancy') }, { label: 'design §3.3.3', href: design('333-receiving-routing-and-paying') }]}
  kind="spec"
  minWidth={720}
>
  <svg viewBox="0 0 720 334" role="img" aria-label="Three boxes. On the left, the CLPR Service processing message i inside submitBundle, with a reentrancy guard held. Step 1, a green arrow to a Channel state box at the top right: checks, then all effects for message i, listing received_message_id, received_running_hash and the Connector charge. Step 2 (the order the specification requires; the pinned reference contracts update the counters and charge the connector after dispatch), an arrow to the target application at the bottom right: dispatch onClprMessage. Step 3, a dashed red arrow curving from the application back to the service: a re-entrant call meets state that has already moved on, and the guard.">
    <defs>
      <marker id="ced-arrow-ok" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--ok)"/></marker>
      <marker id="ced-arrow-a" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--a)"/></marker>
      <marker id="ced-arrow-bad" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--bad)"/></marker>
    </defs>

    <!-- the service, left -->
    <rect x="20" y="78" width="204" height="140" rx="10" class="d-a"/>
    <text x="32" y="100" class="t b">CLPR Service</text>
    <text x="32" y="118" class="t mono">submitBundle</text>
    <text x="32" y="135" class="t small">processing message i</text>
    <text x="32" y="160" class="t small">submitBundle and sendMessage</text>
    <text x="32" y="176" class="t small">have a reentrancy guard</text>
    <rect x="32" y="188" width="120" height="20" rx="10" class="d-grey"/>
    <text x="92" y="202" class="t mono center">guard held</text>

    <!-- 1: checks, then all effects -->
    <line x1="224" y1="98" x2="422" y2="62" class="line ok" marker-end="url(#ced-arrow-ok)"/>
    <circle cx="246" cy="112" r="9" class="d-grey"/><text x="246" y="116" class="t small center b">1</text>
    <text x="262" y="116" class="t small ok">checks, then all effects for i</text>

    <rect x="424" y="24" width="280" height="94" rx="8" class="d-ok"/>
    <text x="436" y="44" class="t b">Channel state (spec: advanced first)</text>
    <text x="436" y="62" class="t mono">received_message_id = i</text>
    <text x="436" y="78" class="t mono">received_running_hash</text>
    <text x="436" y="94" class="t mono">Connector charge</text>
    <text x="436" y="110" class="t small muted">the required order</text>

    <!-- 2: interaction -->
    <line x1="224" y1="176" x2="422" y2="194" class="line a" marker-end="url(#ced-arrow-a)"/>
    <circle cx="246" cy="158" r="9" class="d-grey"/><text x="246" y="162" class="t small center b">2</text>
    <text x="262" y="162" class="t small a">dispatch onClprMessage</text>

    <rect x="424" y="150" width="280" height="90" rx="8" class="d-surface"/>
    <text x="436" y="170" class="t b">Target application</text>
    <text x="436" y="188" class="t small">arbitrary code; it may call back</text>
    <text x="436" y="204" class="t small">into the service</text>
    <text x="436" y="226" class="t mono">onClprMessage(channelId, sender, data)</text>

    <!-- 3: a re-entrant call -->
    <path d="M430,240 C360,282 230,282 172,222" class="line bad dash" marker-end="url(#ced-arrow-bad)"/>
    <circle cx="262" cy="296" r="9" class="d-grey"/><text x="262" y="300" class="t small center b">3</text>
    <text x="278" y="300" class="t small bad">a re-entrant call meets state that has moved on, and the guard</text>

    <!-- takeaway -->
    <text x="360" y="324" class="t take center">Spec: message i is counted and hashed before your callback runs.</text>
  </svg>
</Figure>
