---
/** The EVM reference contracts: one immutable router that owns all state, five DELEGATECALL logic modules that write its storage, and the committed storage layout CI guards, whose slots the endpoint's proofs depend on. Draws on the contracts repository's docs/architecture.md. */
import Figure from '@kse/components/Figure.astro';
import { pinned, sol } from '../../../lib/sources';
---
<Figure
  lead="One router, five modules, one storage layout."
  caption="ClprService.sol is not upgradeable and holds every byte of state; each call is DELEGATECALLed to a logic module that writes into the router's own storage. Because every module writes into that one layout, storage-layout.json is committed and CI regenerates and diffs it on every change; the endpoint's proofs depend on the same slots."
  source={[{ label: 'contracts docs/architecture.md', href: pinned('clpr-smart-contracts', 'docs/architecture.md') }, { label: 'ClprService.sol', href: sol('src/ClprService.sol') }]}
  kind="impl"
  minWidth={720}
>
  <svg viewBox="0 0 720 440" role="img" aria-label="A caller at the top sends a call to ClprService.sol, an immutable router that holds all state. The router fans out by DELEGATECALL to five logic modules: ChannelLogic, MessagingLogic, BundleLogic, ConnectorLogic and AdminLogic. Dashed lines from every module lead down into one box, ClprServiceStorage.sol, the shared storage layout; a libraries box feeds it too. From the storage box a green arrow leads to storage-layout.json, a committed snapshot that CI diffs, and an Endpoint box points at that file to say its proofs depend on the same slots. A separate box lists the pure helpers ClprProtobuf and ClprTypes.">
    <defs>
      <marker id="evm-router-arrow" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--text-3)"/></marker>
      <marker id="evm-router-arrow-ok" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--ok)"/></marker>
      <marker id="evm-router-arrow-c" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--c)"/></marker>
    </defs>

    <!-- caller -->
    <rect x="225" y="14" width="220" height="44" rx="8" class="d-b"/>
    <text x="335" y="32" class="t b center">Caller</text>
    <text x="335" y="49" class="t small center">application · endpoint · admin</text>
    <line x1="335" y1="58" x2="335" y2="90" class="line b" marker-end="url(#evm-router-arrow)"/>
    <text x="347" y="78" class="t small muted">call · reads are not view: use eth_call</text>

    <!-- router -->
    <rect x="150" y="92" width="370" height="62" rx="10" class="d-b"/>
    <text x="335" y="112" class="t b center">ClprService.sol</text>
    <text x="335" y="129" class="t small center">immutable router · holds all state</text>
    <text x="335" y="145" class="t small center">dispatches each call by DELEGATECALL</text>

    <!-- pure helpers, no state -->
    <rect x="548" y="84" width="156" height="76" rx="8" class="d-surface"/>
    <text x="560" y="104" class="t mono">ClprProtobuf*</text>
    <text x="560" y="120" class="t mono">ClprTypes</text>
    <text x="560" y="137" class="t small muted">pure helpers:</text>
    <text x="560" y="152" class="t small muted">types, events, errors</text>

    <!-- fan to five modules -->
    <line x1="335" y1="154" x2="92" y2="188" class="line b" marker-end="url(#evm-router-arrow)"/>
    <line x1="335" y1="154" x2="226" y2="188" class="line b" marker-end="url(#evm-router-arrow)"/>
    <line x1="335" y1="154" x2="360" y2="188" class="line b" marker-end="url(#evm-router-arrow)"/>
    <line x1="335" y1="154" x2="494" y2="188" class="line b" marker-end="url(#evm-router-arrow)"/>
    <line x1="335" y1="154" x2="628" y2="188" class="line b" marker-end="url(#evm-router-arrow)"/>

    <rect x="30" y="190" width="124" height="38" rx="8" class="d-grey"/>
    <text x="92" y="213" class="t mono center">ChannelLogic</text>
    <rect x="164" y="190" width="124" height="38" rx="8" class="d-grey"/>
    <text x="226" y="213" class="t mono center">MessagingLogic</text>
    <rect x="298" y="190" width="124" height="38" rx="8" class="d-grey"/>
    <text x="360" y="213" class="t mono center">BundleLogic</text>
    <rect x="432" y="190" width="124" height="38" rx="8" class="d-grey"/>
    <text x="494" y="213" class="t mono center">ConnectorLogic</text>
    <rect x="566" y="190" width="124" height="38" rx="8" class="d-grey"/>
    <text x="628" y="213" class="t mono center">AdminLogic</text>

    <!-- modules write the router's storage -->
    <line x1="92" y1="228" x2="92" y2="260" class="line dash" marker-end="url(#evm-router-arrow)"/>
    <line x1="226" y1="228" x2="226" y2="260" class="line dash" marker-end="url(#evm-router-arrow)"/>
    <line x1="360" y1="228" x2="360" y2="260" class="line dash" marker-end="url(#evm-router-arrow)"/>
    <line x1="494" y1="228" x2="494" y2="260" class="line dash" marker-end="url(#evm-router-arrow)"/>
    <line x1="628" y1="228" x2="628" y2="260" class="line dash" marker-end="url(#evm-router-arrow)"/>

    <rect x="30" y="262" width="660" height="46" rx="8" class="d-surface"/>
    <text x="42" y="282" class="t b">ClprServiceStorage.sol</text>
    <text x="42" y="299" class="t small">the one shared storage layout: every module reads and writes the router's own storage</text>

    <!-- libraries -->
    <line x1="190" y1="330" x2="190" y2="310" class="line dash" marker-end="url(#evm-router-arrow)"/>
    <rect x="30" y="332" width="320" height="60" rx="8" class="d-grey"/>
    <text x="42" y="352" class="t mono">BundleLib · ConnectorLib · ManifestLib</text>
    <text x="42" y="369" class="t small">state-mutating helpers;</text>
    <text x="42" y="385" class="t small">they take storage references</text>

    <!-- snapshot and the endpoint -->
    <line x1="470" y1="308" x2="470" y2="330" class="line ok" marker-end="url(#evm-router-arrow-ok)"/>
    <text x="480" y="324" class="t small ok">snapshot</text>
    <rect x="380" y="332" width="180" height="60" rx="8" class="d-ok"/>
    <text x="392" y="352" class="t mono">storage-layout.json</text>
    <text x="392" y="369" class="t small">committed snapshot;</text>
    <text x="392" y="385" class="t small">CI regenerates and diffs it</text>
    <line x1="590" y1="362" x2="562" y2="362" class="line c" marker-end="url(#evm-router-arrow-c)"/>
    <rect x="592" y="332" width="98" height="60" rx="8" class="d-c"/>
    <text x="641" y="352" class="t b center">Endpoint</text>
    <text x="641" y="369" class="t small center">proves the</text>
    <text x="641" y="385" class="t small center">same slots</text>

    <!-- takeaway -->
    <text x="360" y="424" class="t take center">One contract owns the state; modules borrow its storage; CI guards the layout that proofs depend on.</text>
  </svg>
</Figure>
