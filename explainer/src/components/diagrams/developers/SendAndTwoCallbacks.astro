---
/** The application surface in one round trip: sendMessage out, onClprMessage on the peer, onClprResponse back under the same message_id; spec §6.4-6.5, design §3.3.3. */
import Figure from '@kse/components/Figure.astro';
import { design, spec, sol } from '../../../lib/sources';
---
<Figure
  lead="One call out, two callbacks in."
  caption="sendMessage returns a message_id; the destination's onClprMessage return value becomes the reply; that reply reaches your onClprResponse under the same message_id. Steps 2, 3, 6 and 7 are the transport the earlier sections describe."
  source={[{ label: 'spec §6.4', href: spec('64-messaging') }, { label: 'spec §6.5 Application Delivery', href: spec('application-delivery') }, { label: 'design §3.3.3', href: design('333-receiving-routing-and-paying') }, { label: 'IClprApplication.sol', href: sol('src/interfaces/IClprApplication.sol') }]}
  kind="spec"
  minWidth={740}
>
  <svg viewBox="0 0 740 300" role="img" aria-label="Eight numbered steps. Your contract on ledger A calls sendMessage and gets a message_id; CLPR Service A queues the message; endpoints submit the bundle to CLPR Service B; the service calls onClprMessage on the target contract; the returned bytes become the reply; it is queued as a Response Message; endpoints submit it back; CLPR Service A calls onClprResponse on your contract with the same message_id.">
    <defs>
      <marker id="stc-arrow-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--a)" /></marker>
      <marker id="stc-arrow-b" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--b)" /></marker>
    </defs>

    <!-- contracts -->
    <rect x="16" y="16" width="200" height="64" rx="8" class="d-a" />
    <text x="116" y="38" class="t b center">Your contract on A</text>
    <text x="116" y="56" class="t small center">calls sendMessage;</text>
    <text x="116" y="70" class="t small center">receives onClprResponse</text>

    <rect x="524" y="16" width="200" height="64" rx="8" class="d-b" />
    <text x="624" y="38" class="t b center">Target contract on B</text>
    <text x="624" y="56" class="t small center">onClprMessage runs;</text>
    <text x="624" y="70" class="t small center">returned bytes = the reply</text>

    <!-- services and endpoints -->
    <rect x="16" y="170" width="180" height="84" rx="8" class="d-a" />
    <text x="106" y="192" class="t b center">CLPR Service A</text>
    <text x="106" y="210" class="t small center">assigns message_id;</text>
    <text x="106" y="224" class="t small center">enqueues the message;</text>
    <text x="106" y="238" class="t small center">delivers the response</text>

    <rect x="310" y="170" width="120" height="84" rx="8" class="d-c" />
    <text x="370" y="192" class="t b center">Endpoints</text>
    <text x="370" y="210" class="t small center">sync, prove,</text>
    <text x="370" y="226" class="t mono center">submitBundle</text>
    <text x="370" y="242" class="t small center">both directions</text>

    <rect x="544" y="170" width="180" height="84" rx="8" class="d-b" />
    <text x="634" y="192" class="t b center">CLPR Service B</text>
    <text x="634" y="210" class="t small center">verifies the bundle;</text>
    <text x="634" y="224" class="t small center">charges the connector;</text>
    <text x="634" y="238" class="t small center">queues the reply</text>

    <!-- 1 send -->
    <line x1="50" y1="80" x2="50" y2="168" class="line a" marker-end="url(#stc-arrow-a)" />
    <circle cx="34" cy="110" r="9" class="d-grey" /><text x="34" y="114" class="t small center b">1</text>
    <text x="60" y="118" class="t mono">sendMessage(…)</text>
    <text x="60" y="132" class="t mono">→ message_id</text>

    <!-- 8 response callback -->
    <line x1="180" y1="170" x2="180" y2="82" class="line b" marker-end="url(#stc-arrow-b)" />
    <circle cx="166" cy="110" r="9" class="d-grey" /><text x="166" y="114" class="t small center b">8</text>
    <text x="190" y="118" class="t mono">onClprResponse(…)</text>
    <text x="190" y="132" class="t small">same message_id</text>

    <!-- 2, 3: request lane -->
    <circle cx="207" cy="190" r="9" class="d-grey" /><text x="207" y="194" class="t small center b">2</text>
    <line x1="218" y1="190" x2="308" y2="190" class="line a" marker-end="url(#stc-arrow-a)" />
    <text x="263" y="206" class="t small center">bundle + proof</text>

    <circle cx="441" cy="190" r="9" class="d-grey" /><text x="441" y="194" class="t small center b">3</text>
    <line x1="452" y1="190" x2="542" y2="190" class="line a" marker-end="url(#stc-arrow-a)" />
    <text x="497" y="206" class="t mono center">submitBundle</text>

    <!-- 4 deliver, 5 reply -->
    <line x1="574" y1="170" x2="574" y2="82" class="line a" marker-end="url(#stc-arrow-a)" />
    <circle cx="558" cy="110" r="9" class="d-grey" /><text x="558" y="114" class="t small center b">4</text>
    <text x="584" y="118" class="t mono">onClprMessage(…)</text>
    <text x="584" y="132" class="t small">channelId, sender, data</text>

    <line x1="704" y1="80" x2="704" y2="168" class="line b" marker-end="url(#stc-arrow-b)" />
    <circle cx="688" cy="150" r="9" class="d-grey" /><text x="688" y="154" class="t small center b">5</text>
    <text x="674" y="148" class="t small end">returned bytes</text>
    <text x="674" y="162" class="t small end">= the reply</text>

    <!-- 6, 7: response lane -->
    <circle cx="533" cy="236" r="9" class="d-grey" /><text x="533" y="240" class="t small center b">6</text>
    <line x1="522" y1="236" x2="432" y2="236" class="line b" marker-end="url(#stc-arrow-b)" />
    <text x="477" y="252" class="t small center">Response Message</text>

    <circle cx="299" cy="236" r="9" class="d-grey" /><text x="299" y="240" class="t small center b">7</text>
    <line x1="288" y1="236" x2="198" y2="236" class="line b" marker-end="url(#stc-arrow-b)" />
    <text x="243" y="252" class="t mono center">submitBundle</text>

    <text x="370" y="284" class="t take center">The message_id from step 1 is the key you match in step 8.</text>
  </svg>
</Figure>
