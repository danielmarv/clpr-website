---
/** The closing states on both ledgers at once: the admin closes on A, the status rides in ChannelSyncData on the next bundle, B follows into CLOSING, each side drains its own queue, and each reaches CLOSED only once the peer reports DRAINED or CLOSED and all its own messages are acknowledged. Draws on spec §2.1 and design §3.1.3. */
import Figure from '@kse/components/Figure.astro';
import { design, spec } from '../../../lib/sources';
---
<Figure
  lead="How a close crosses the gap."
  caption="The admin closes on one ledger; the new status rides in ChannelSyncData on the next bundle, the peer follows into CLOSING, each side drains its own queue, and each reaches CLOSED only once the peer reports DRAINED or CLOSED and every message it sent is acknowledged."
  source={[{ label: 'spec §2.1', href: spec('21-channel') }, { label: 'design §3.1.3', href: design('313-establishing-and-updating-channels') }]}
  kind="spec"
  minWidth={760}
>
  <svg viewBox="0 0 760 390" role="img" aria-label="Two horizontal lanes, Ledger A above and Ledger B below, each running ACTIVE, CLOSING, DRAINED, CLOSED left to right. An admin box above Ledger A calls closeChannel into ACTIVE. Between the lanes, a bundle carries status = CLOSING from A's CLOSING down to B's CLOSING; a two-headed arrow between the DRAINED boxes says bundles keep flowing with responses and acknowledgements, then each side reports status = DRAINED; a dashed two-headed arrow between the CLOSED boxes carries a bundle with status = CLOSED.">
    <defs>
      <marker id="tsc-arrow" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--text-3)"/></marker>
      <marker id="tsc-arrow-a" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--a)"/></marker>
      <marker id="tsc-arrow-b" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--b)"/></marker>
      <marker id="tsc-arrow-c" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto-start-reverse"><path d="M0,0 L8,4.5 L0,9 Z" fill="var(--c)"/></marker>
    </defs>

    <!-- Admin triggers the close on A -->
    <rect x="96" y="12" width="130" height="40" rx="8" class="d-grey"/>
    <text x="161" y="29" class="t b small center">Admin (Ledger A)</text>
    <text x="161" y="44" class="t mono center">closeChannel</text>
    <line x1="161" y1="52" x2="161" y2="70" class="line" marker-end="url(#tsc-arrow)"/>

    <!-- Lane A -->
    <text x="20" y="118" class="t b a">Ledger A</text>
    <rect x="96" y="72" width="130" height="84" rx="8" class="d-a"/>
    <text x="161" y="94" class="t b center">ACTIVE</text>
    <text x="161" y="112" class="t small center">normal operation</text>
    <text x="161" y="126" class="t small center muted">(or PAUSED)</text>
    <line x1="226" y1="114" x2="244" y2="114" class="line a" marker-end="url(#tsc-arrow-a)"/>
    <rect x="246" y="72" width="130" height="84" rx="8" class="d-a"/>
    <text x="311" y="94" class="t b center">CLOSING</text>
    <text x="311" y="112" class="t small center">sendMessage rejected;</text>
    <text x="311" y="126" class="t small center">inbound still served</text>
    <line x1="376" y1="114" x2="394" y2="114" class="line a" marker-end="url(#tsc-arrow-a)"/>
    <rect x="396" y="72" width="130" height="84" rx="8" class="d-a"/>
    <text x="461" y="94" class="t b center">DRAINED</text>
    <text x="461" y="112" class="t small center">all own Data</text>
    <text x="461" y="126" class="t small center">Messages acked</text>
    <line x1="526" y1="114" x2="544" y2="114" class="line a" marker-end="url(#tsc-arrow-a)"/>
    <rect x="546" y="72" width="130" height="84" rx="8" class="d-a"/>
    <text x="611" y="94" class="t b center">CLOSED</text>
    <text x="611" y="112" class="t small center">peer DRAINED or</text>
    <text x="611" y="126" class="t small center">CLOSED, and all own</text>
    <text x="611" y="140" class="t small center">messages acked</text>

    <!-- Lane B -->
    <text x="20" y="308" class="t b b-col">Ledger B</text>
    <rect x="96" y="262" width="130" height="84" rx="8" class="d-b"/>
    <text x="161" y="284" class="t b center">ACTIVE</text>
    <text x="161" y="302" class="t small center">normal operation</text>
    <line x1="226" y1="304" x2="244" y2="304" class="line b" marker-end="url(#tsc-arrow-b)"/>
    <rect x="246" y="262" width="130" height="84" rx="8" class="d-b"/>
    <text x="311" y="284" class="t b center">CLOSING</text>
    <text x="311" y="302" class="t small center">followed the</text>
    <text x="311" y="316" class="t small center">peer's status</text>
    <line x1="376" y1="304" x2="394" y2="304" class="line b" marker-end="url(#tsc-arrow-b)"/>
    <rect x="396" y="262" width="130" height="84" rx="8" class="d-b"/>
    <text x="461" y="284" class="t b center">DRAINED</text>
    <text x="461" y="302" class="t small center">its own queue</text>
    <text x="461" y="316" class="t small center">fully acknowledged</text>
    <line x1="526" y1="304" x2="544" y2="304" class="line b" marker-end="url(#tsc-arrow-b)"/>
    <rect x="546" y="262" width="130" height="84" rx="8" class="d-b"/>
    <text x="611" y="284" class="t b center">CLOSED</text>
    <text x="611" y="302" class="t small center">peer DRAINED or</text>
    <text x="611" y="316" class="t small center">CLOSED, and all own</text>
    <text x="611" y="330" class="t small center">messages acked</text>

    <!-- Bundles between the lanes -->
    <line x1="311" y1="158" x2="311" y2="258" class="line c" marker-end="url(#tsc-arrow-c)"/>
    <text x="319" y="200" class="t small">bundle:</text>
    <text x="319" y="216" class="t mono">status = CLOSING</text>

    <line x1="461" y1="160" x2="461" y2="258" class="line c" marker-start="url(#tsc-arrow-c)" marker-end="url(#tsc-arrow-c)"/>
    <text x="469" y="186" class="t small">bundles keep flowing</text>
    <text x="469" y="202" class="t small">(responses, acks);</text>
    <text x="469" y="218" class="t small">then each reports</text>
    <text x="469" y="234" class="t mono">status = DRAINED</text>

    <line x1="611" y1="160" x2="611" y2="258" class="line c dash" marker-start="url(#tsc-arrow-c)" marker-end="url(#tsc-arrow-c)"/>
    <text x="619" y="200" class="t small">bundle:</text>
    <text x="619" y="216" class="t mono">status = CLOSED</text>

    <!-- takeaway -->
    <text x="380" y="376" class="t take center">Closing is a two-sided drain: a side closes only when it has drained and the peer says it has too.</text>
  </svg>
</Figure>
