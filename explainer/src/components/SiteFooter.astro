---
/**
 * The CLPR website's footer (src/components/SiteFooter.tsx there) as static HTML: channel edge,
 * link columns, partner logos, wordmark and legal line, with the explainer's own status and licence
 * lines (pack.json `footer`) above the legal line. The logos are the website's public/logos/ files,
 * inlined as data URLs so a standalone build and the single-file export carry them too.
 */
import ClprMark from './ClprMark.astro';
import { SOURCES, PACK } from '../lib/sources';
import lfdt from '../../../public/logos/lfdt-horizontal-color.svg?raw';
import lfdtDark from '../../../public/logos/lfdt-horizontal-white.svg?raw';
import hashgraph from '../../../public/logos/hashgraph-black.svg?raw';
import hashgraphDark from '../../../public/logos/hashgraph-white.svg?raw';
import hedera from '../../../public/logos/hedera-lockup-black.svg?raw';
import hederaDark from '../../../public/logos/hedera-lockup-white.svg?raw';
import hiero from '../../../public/logos/hiero.svg?raw';
import hieroDark from '../../../public/logos/hiero-white.svg?raw';

const year = new Date().getFullYear();
const columns = [
  { title: 'Explore', links: [
    { label: 'How it works', href: '/#how-it-works' }, { label: 'Why bridgeless', href: '/#protocol' },
    { label: 'Architecture', href: '/#architecture' }, { label: 'Code', href: '/#code' },
    { label: 'The plumbing of CLPR', href: import.meta.env.BASE_URL },
    { label: 'For developers', href: `${import.meta.env.BASE_URL}developers/` },
    { label: 'Glossary', href: `${import.meta.env.BASE_URL}developers/#glossary` },
  ] },
  { title: 'Build', links: [
    { label: 'Specification', href: 'https://github.com/LFDT-CLPR/clpr-spec' },
    { label: 'Smart contracts', href: 'https://github.com/LFDT-CLPR/clpr-smart-contracts' },
    { label: 'Endpoint', href: 'https://github.com/LFDT-CLPR/clpr-endpoint' },
    { label: 'Native Hiero integration', href: 'https://github.com/hiero-ledger/hiero-consensus-node/pull/27029' },
    { label: 'All repositories', href: 'https://github.com/LFDT-CLPR' },
  ] },
  { title: 'Project', links: [
    { label: 'Governance', href: 'https://github.com/LFDT-CLPR/governance' },
    { label: 'Lab proposal', href: 'https://github.com/LF-Decentralized-Trust/lab-proposals/issues/5' },
    { label: 'Developer Certificate of Origin', href: 'https://developercertificate.org/' },
    { label: 'Apache License 2.0', href: 'https://www.apache.org/licenses/LICENSE-2.0' },
  ] },
];
const external = (href: string) => /^https?:\/\//.test(href);
const dataUrl = (svg: string) => `data:image/svg+xml,${encodeURIComponent(svg)}`;
// Heights follow the website's footer. Each mark in its own colours, and its version for dark
// backgrounds; the theme shows one of the two.
const backing = [
  { label: 'A lab of', logos: [
    { name: 'LF Decentralized Trust', href: 'https://www.lfdecentralizedtrust.org/', src: dataUrl(lfdt), srcDark: dataUrl(lfdtDark), width: 698.7, height: 39.1, class: 'lfdt' },
  ] },
  { label: 'Contributed by', logos: [
    { name: 'Hashgraph', href: 'https://hashgraph.com/clpr/', src: dataUrl(hashgraph), srcDark: dataUrl(hashgraphDark), width: 654.62, height: 141.73, class: 'hashgraph' },
    { name: 'Hedera', href: 'https://hedera.com', src: dataUrl(hedera), srcDark: dataUrl(hederaDark), width: 448.29, height: 138.93, class: 'hedera' },
  ] },
  { label: 'Native service for', logos: [
    { name: 'Hiero', href: 'https://hiero.org', src: dataUrl(hiero), srcDark: dataUrl(hieroDark), width: 64, height: 20, class: 'hiero' },
  ] },
];
const hexagon = 'M0 -8.5L7.4 -4.25V4.25L0 8.5L-7.4 4.25V-4.25Z';
---
<footer class="site-footer">
  <div class="shell site-footer__edge" aria-hidden="true">
    <svg class="hex" viewBox="-10 -10 20 20" fill="none"><path d={hexagon} fill="var(--bg)" stroke="var(--signal-glow)" stroke-width="1.4" /></svg>
    <div class="channel">
      <svg viewBox="0 0 1000 20" preserveAspectRatio="none" fill="none">
        <defs>
          <linearGradient id="footer-channel" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="var(--signal-glow)" />
            <stop offset="1" stop-color="var(--proof-glow)" />
          </linearGradient>
        </defs>
        {[-2, -1, 0, 1, 2].map((k) => (
          <path d={`M0 10C330 ${10 + k * 4} 670 ${10 - k * 4} 1000 10`} stroke="url(#footer-channel)" stroke-opacity="0.7" stroke-width="1" vector-effect="non-scaling-stroke" />
        ))}
      </svg>
      <span class="packet"></span>
      <span class="packet back"></span>
    </div>
    <svg class="hex" viewBox="-10 -10 20 20" fill="none"><path d={hexagon} fill="var(--bg)" stroke="var(--proof-glow)" stroke-width="1.4" /></svg>
  </div>

  <div class="shell site-footer__main">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="/" aria-label="CLPR home"><ClprMark /><span>CLPR</span></a>
        <p class="expansion">Cross Ledger Protocol</p>
        <p class="tagline">Bridgeless cross-ledger messaging, specified in the open.</p>
      </div>
      <nav class="site-footer__cols" aria-label="Footer">
        {columns.map((column) => (
          <div>
            <h2>{column.title}</h2>
            <ul>
              {column.links.map((item) => (
                <li>{external(item.href)
                  ? <a href={item.href} target="_blank" rel="noreferrer">{item.label}<svg class="ext" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10v10" /><path d="M7 17 17 7" /></svg><span class="visually-hidden"> (opens in a new tab)</span></a>
                  : <a href={item.href}>{item.label}</a>}</li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>
    <section class="site-footer__backing" aria-label="Who is behind CLPR">
      {backing.map((group) => (
        <div>
          <p>{group.label}</p>
          <div class="logos">
            {group.logos.map((logo) => (
              <a href={logo.href} target="_blank" rel="noreferrer">
                <img src={logo.src} alt={`${logo.name} (opens in a new tab)`} width={logo.width} height={logo.height} class={`${logo.class} on-light`} />
                <img src={logo.srcDark} alt={`${logo.name} (opens in a new tab)`} width={logo.width} height={logo.height} class={`${logo.class} on-dark`} />
              </a>
            ))}
          </div>
        </div>
      ))}
    </section>
  </div>

  <div class="shell" aria-hidden="true">
    <p class="site-footer__wordmark" data-pointer-glow>CLPR</p>
  </div>

  <div class="shell">
    <div class="site-footer__legal">
      <div>
        {PACK.footer.map((html) => <p class="about" set:html={html.replace('{{orgUrl}}', SOURCES.org.url).replace('{{labUrl}}', SOURCES.org.labUrl ?? '')} />)}
        <p class="affiliation">An LF Decentralized Trust Lab</p>
        <p>Code is licensed under Apache-2.0; under the Labs charter, specifications are developed under the Community Specification License 1.0.</p>
        <p>© {year} The Linux Foundation. All rights reserved. The Linux Foundation has registered trademarks and uses trademarks. For a list of trademarks of The Linux Foundation, please see our <a href="https://www.linuxfoundation.org/legal/trademark-usage" target="_blank" rel="noreferrer">Trademark Usage<span class="visually-hidden"> (opens in a new tab)</span></a> page.</p>
      </div>
      <a href="#main">Back to top<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 7-7 7 7" /><path d="M12 19V5" /></svg></a>
    </div>
  </div>
</footer>

<script>
  // The wordmark's light follows the mouse, as on the website (SiteMotion.tsx there); without a
  // mouse the CSS sweeps it on its own.
  const glows = document.querySelectorAll<HTMLElement>('[data-pointer-glow]');
  let pointer: { x: number; y: number } | null = null;
  const track = () => {
    if (!pointer) return;
    const { x, y } = pointer;
    glows.forEach((glow) => {
      const rect = glow.getBoundingClientRect();
      if (rect.bottom < -200 || rect.top > window.innerHeight + 200) return;
      glow.style.setProperty('--mx', `${x - rect.left}px`);
      glow.style.setProperty('--my', `${y - rect.top}px`);
    });
  };
  document.addEventListener('pointermove', (event) => {
    if (event.pointerType !== 'mouse') return;
    pointer = { x: event.clientX, y: event.clientY };
    track();
  }, { passive: true });
  // A still pointer over a scrolling page keeps the glow under it.
  window.addEventListener('scroll', track, { passive: true });
</script>
