---
/**
 * The CLPR website's footer (src/components/SiteFooter.tsx there) as static HTML, with the
 * explainer's own status and licence lines (pack.json `footer`) above the legal line. The partner
 * logos are text links here: the website's logo files are not part of this build.
 */
import ClprMark from './ClprMark.astro';
import { SOURCES, PACK } from '../lib/sources';

const year = new Date().getFullYear();
const columns = [
  { title: 'Explore', links: [
    { label: 'How it works', href: '/#how-it-works' }, { label: 'Why bridgeless', href: '/#protocol' },
    { label: 'Architecture', href: '/#architecture' }, { label: 'Code', href: '/#code' },
    { label: 'Terminology', href: '/#terminology' }, { label: 'The plumbing of CLPR', href: import.meta.env.BASE_URL },
  ] },
  { title: 'Build', links: [
    { label: 'Specification', href: 'https://github.com/LFDT-CLPR/clpr-spec' },
    { label: 'Smart contracts', href: 'https://github.com/LFDT-CLPR/clpr-smart-contracts' },
    { label: 'Endpoint', href: 'https://github.com/LFDT-CLPR/clpr-endpoint' },
    { label: 'Native Hiero integration', href: 'https://github.com/hiero-ledger/hiero-consensus-node/pull/27029' },
    { label: 'All repositories', href: 'https://github.com/LFDT-CLPR' },
  ] },
  { title: 'Project', links: [
    { label: 'Governance', href: 'https://github.com/LFDT-CLPR/governance' },
    { label: 'Lab proposal', href: 'https://github.com/LF-Decentralized-Trust/lab-proposals/issues/5' },
    { label: 'Developer Certificate of Origin', href: 'https://developercertificate.org/' },
    { label: 'Apache License 2.0', href: 'https://www.apache.org/licenses/LICENSE-2.0' },
  ] },
];
const external = (href: string) => /^https?:\/\//.test(href);
---
<footer class="site-footer">
  <div class="shell">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="/" aria-label="CLPR home"><ClprMark /><span>CLPR</span></a>
        <p class="expansion">Cross Ledger Protocol</p>
        <p class="tagline">Bridgeless cross-ledger messaging, specified in the open.</p>
      </div>
      <nav class="site-footer__cols" aria-label="Footer">
        {columns.map((column) => (
          <div>
            <h2>{column.title}</h2>
            <ul>
              {column.links.map((item) => (
                <li>{external(item.href)
                  ? <a href={item.href} target="_blank" rel="noreferrer">{item.label}<span class="ext" aria-hidden="true">↗</span></a>
                  : <a href={item.href}>{item.label}</a>}</li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>
    <section class="site-footer__backing" aria-label="Who is behind CLPR">
      <div><p class="faint">Stewarded by</p><a href="https://www.lfdecentralizedtrust.org/" target="_blank" rel="noreferrer">LF Decentralized Trust</a></div>
      <div><p class="faint">Contributed by</p><a href="https://hashgraph.com/clpr/" target="_blank" rel="noreferrer">Hashgraph</a> · <a href="https://hedera.com" target="_blank" rel="noreferrer">Hedera</a></div>
      <div><p class="faint">Built natively into</p><a href="https://hiero.org" target="_blank" rel="noreferrer">Hiero</a></div>
    </section>
    <div class="site-footer__about">
      {PACK.footer.map((html) => <p set:html={html.replace('{{orgUrl}}', SOURCES.org.url).replace('{{labUrl}}', SOURCES.org.labUrl ?? '')} />)}
    </div>
    <div class="site-footer__legal">
      <p>© {year} CLPR contributors. Code is licensed under Apache-2.0; the specification under the Community Specification License 1.0. LF Decentralized Trust is a project of The Linux Foundation.</p>
      <a href="#main">Back to top ↑</a>
    </div>
  </div>
</footer>
